# Entorno de pruebas seguro para Clarvex
NODE_ENV=test
ALLOW_INTEGRATION_TEST_DATABASE=true

# URL exclusiva para la base de datos de pruebas (debe contener la palabra "test")
TEST_DATABASE_URL="postgresql://clarvex:CambiaEstaPasswordSegura123@localhost:5432/clarvex_test?schema=public"

# URL base del servidor de pruebas
TEST_BASE_URL="http://127.0.0.1:3101"

# Simulación de servicios externos
MOCK_EXTERNAL_SERVICES=true
GEMINI_API_KEY="mock-gemini-key"
MP_ACCESS_TOKEN="mock-mercadopago-token"
R2_BUCKET_NAME="clarvex-test-uploads"
CRON_SECRET="mock-cron-secret"

# ⚠️ Las claves VAPID NO admiten un valor "mock" cualquiera. `lib/push.ts` llama
# a webpush.setVapidDetails() AL IMPORTARSE, y web-push exige que la pública
# decodifique a exactamente 65 bytes. Con un texto suelto, todo test que importe
# (directa o indirectamente) lib/push.ts revienta con:
#   "Vapid public key should be 65 bytes long when decoded."
#
# Genera un par válido y desechable — NUNCA reutilices el de producción:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:test@clarvex.local"
