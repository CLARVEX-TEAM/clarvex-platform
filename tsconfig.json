{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    /*
     * ⚠️ ACTIVADO el 4 de septiembre de 2026. Estaba en `false` como excepcion
     * a `strict`, y al activarlo salieron SOLO DOS errores. Los dos eran el
     * MISMO fallo real: el mapa de etiquetas de rol no incluia `REGIONAL`, asi
     * que a esa persona se le pintaba la insignia vacia.
     *
     * Un `any` implicito escondia un hueco de datos, no un problema de tipos.
     */
    "noImplicitAny": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "//": "'Microsoft VS Code' es una instalacion de programa dentro del proyecto: trae sus propios .ts y el patron **/*.ts los recogia, asi que el typecheck fallaba por codigo ajeno. Se excluye igual que en .eslintrc.json y .gitignore. No se puede mover: es la instalacion viva del editor.",
  // ⚠️ `tmp/` ya estaba en `.gitignore` pero NO aquí, y eso rompía `tsc` sin
  // decir por qué: las copias de trabajo que se dejan ahí --builds aislados,
  // reproducciones de un fallo-- traen su propio código a medias, y el patrón
  // `**/*.ts` las recogía. Salían errores de módulos inexistentes en archivos
  // que no son de nadie, y se lee como si el proyecto estuviera roto. Es la
  // misma trampa que "Microsoft VS Code", que está aquí por lo mismo.
  "exclude": ["node_modules", "Microsoft VS Code", "tmp"]
}
