generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  GERENTE
  SUBGERENTE
  ASESOR
}

enum PendingCategory {
  OPERACION
  EQUIPO
  COMERCIAL
  CLIENTE
  INVENTARIO
  MANTENIMIENTO
}

enum PendingPriority {
  BAJA
  MEDIA
  ALTA
  CRITICA
}

enum PendingStatus {
  PENDIENTE
  EN_PROCESO
  COMPLETADO
}

enum DataSourceType {
  HORARIOS
  KPIS
  METAS
  COMISIONES
  COMUNICADOS
  DESCUENTOS_POS
}

enum DataSourceProvider {
  MANUAL
  EXCEL
  SHAREPOINT
}

enum DataSourceStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

enum DataSourceFrequency {
  MANUAL
  HOURLY
  DAILY
  WEEKLY
}

enum SyncLogStatus {
  SUCCESS
  ERROR
  RUNNING
}

enum ScheduleStatus {
  WORKING
  OFF
  VACATION
  PAID_DAY
  INVENTORY
  TERMINATED
}

enum NotificationType {
  PLAN_READY
  NEW_ANNOUNCEMENT
  PENDING_ASSIGNED
  TASK_COMPLETED
  KPI_GOAL_REACHED
  COMMENT_ADDED
  EVIDENCE_ADDED
  DAILY_SUMMARY
  ANNOUNCEMENT_REACTION
  CELEBRATION
  KUDO
  SHIFT_REQUEST
  INVENTORY_REPORT
  NEW_TRAINING
  SURVEY
  NEW_CHAT_MESSAGE
}

enum ChatRoomType {
  DIRECT
  GROUP
}

model Store {
  id             String         @id @default(cuid())
  name           String
  users          User[]
  kpis           Kpi[]
  schedules      Schedule[]
  plans          DayPlan[]
  pendings       Pending[]
  logEntries     StoreLog[]
  announcements  Announcement[]
  evidences      Evidence[]
  commissionRules CommissionRule[]
  dataSources     DataSource[]
  notifications   Notification[]
  comments        Comment[]
  kpiTargets      KpiTarget[]
  checklistEntries ChecklistEntry[]
  kudos           Kudo[]
  shiftRequests   ShiftRequest[]
  inventoryReports InventoryReport[]
  trainingResources TrainingResource[]
  choreAssignments ChoreAssignment[]
  fixtures        StoreFixture[]
  surveys         Survey[]
  chatRooms       ChatRoom[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model StoreFixture {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  type      String   @default("TABLE") // WALL | TABLE | ROUND | RACK | CURVE | COUNTER
  col       Int      @default(1)
  row       Int      @default(1)
  posX      Float    @default(0) // posición libre en el plano 3D
  posZ      Float    @default(0)
  rotation  Int      @default(0) // grados 0 | 90 | 180 | 270
  styles    String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId])
}

model DataSource {
  id         String             @id @default(cuid())
  storeId    String
  store      Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  type       DataSourceType
  provider   DataSourceProvider @default(MANUAL)
  name       String
  url        String?
  status     DataSourceStatus   @default(DISCONNECTED)
  frequency  DataSourceFrequency @default(MANUAL)
  lastSyncAt DateTime?
  nextSyncAt DateTime?
  syncLogs   SyncLog[]
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@unique([storeId, type])
  @@index([storeId, status])
}

model SyncLog {
  id               String        @id @default(cuid())
  dataSourceId     String
  dataSource       DataSource    @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)
  status           SyncLogStatus
  message          String
  recordsProcessed Int           @default(0)
  createdAt        DateTime      @default(now())

  @@index([dataSourceId, createdAt])
}

model User {
  id                    String                 @id @default(cuid())
  name                  String
  email                 String                 @unique
  employeeNumber        String                 @unique
  passwordHash          String?
  pinHash               String?
  photoUrl              String?
  biometricEnabled      Boolean                @default(false)
  lastLoginAt           DateTime?
  lastSeenAt            DateTime?
  birthDate             DateTime?
  hireDate              DateTime?
  hoursOwed             Float                  @default(0)
  vacationDays          Float                  @default(0)
  paidDays              Float                  @default(0)
  role                  Role
  storeId               String
  store                 Store                  @relation(fields: [storeId], references: [id])
  kpis                  Kpi[]
  schedules             Schedule[]
  plans                 DayPlan[]
  assignedPendings      Pending[]              @relation("PendingOwner")
  authoredLogs          StoreLog[]
  evidences             Evidence[]             @relation("EvidenceAuthor")
  authoredAnnouncements Announcement[]
  announcementReads     AnnouncementRead[]
  announcementReactions AnnouncementReaction[]
  employeeNumberAliases EmployeeNumberAlias[]
  notifications         Notification[]
  pushSubscriptions     PushSubscription[]
  webAuthnCredentials   WebAuthnCredential[]
  comments              Comment[]              @relation("CommentAuthor")
  kudosSent             Kudo[]                 @relation("KudoFrom")
  kudosReceived         Kudo[]                 @relation("KudoTo")
  shiftRequests         ShiftRequest[]         @relation("ShiftRequester")
  inventoryReports      InventoryReport[]      @relation("InventoryReporter")
  inventoryResolved     InventoryReport[]      @relation("InventoryResolver")
  authoredTraining      TrainingResource[]     @relation("TrainingAuthor")
  trainingViews         TrainingResourceView[] @relation("TrainingViewer")
  choreAssignments      ChoreAssignment[]
  authoredSurveys       Survey[]               @relation("SurveyAuthor")
  surveyResponses       SurveyResponse[]       @relation("SurveyRespondent")
  chatMemberships       ChatMember[]
  chatMessages          ChatMessage[]
  chatMessageReads      ChatMessageRead[]
  chatMessageDeliveries ChatMessageDelivery[]
  chatMessageHides      ChatMessageHide[]
  chatMessageReactions  ChatMessageReaction[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
}

model TrainingResource {
  id          String                 @id @default(cuid())
  storeId     String
  store       Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  authorId    String
  author      User                   @relation("TrainingAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  title       String
  description String?
  category    String                 // VENTAS | PRODUCTO | ATENCION | POLITICAS | OTRO
  linkUrl     String?
  fileUrl     String?
  fileName    String?
  views       TrainingResourceView[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([storeId, createdAt])
}

model TrainingResourceView {
  id         String           @id @default(cuid())
  resourceId String
  resource   TrainingResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  userId     String
  user       User             @relation("TrainingViewer", fields: [userId], references: [id], onDelete: Cascade)
  viewedAt   DateTime         @default(now())

  @@unique([resourceId, userId])
  @@index([resourceId])
}

model InventoryReport {
  id           String    @id @default(cuid())
  storeId      String
  store        Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  reporterId   String
  reporter     User      @relation("InventoryReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  productName  String
  category     String    // AGOTADO | DANADO | FALTANTE | ETIQUETA | OTRO
  note         String?
  photoUrl     String?
  status       String    @default("ABIERTO") // ABIERTO | RESUELTO
  resolvedById String?
  resolvedBy   User?     @relation("InventoryResolver", fields: [resolvedById], references: [id])
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([storeId, status, createdAt])
}

model ShiftRequest {
  id           String    @id @default(cuid())
  storeId      String
  store        Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  requesterId  String
  requester    User      @relation("ShiftRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  date         String    // "YYYY-MM-DD"
  type         String    // VACACIONES | DESCANSO | PAGO_DIA | SALIR_TEMPRANO | ENTRAR_TARDE
  hours        Float?    // para SALIR_TEMPRANO / ENTRAR_TARDE
  reason       String?
  status       String    @default("PENDIENTE") // PENDIENTE | APROBADO | RECHAZADO
  resolvedById String?
  resolvedAt   DateTime?
  managerNote  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([storeId, status, date])
  @@index([requesterId, createdAt])
}

model Kudo {
  id         String   @id @default(cuid())
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  fromUserId String
  fromUser   User     @relation("KudoFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User     @relation("KudoTo", fields: [toUserId], references: [id], onDelete: Cascade)
  emoji      String
  message    String?
  createdAt  DateTime @default(now())

  @@index([storeId, createdAt])
  @@index([toUserId, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  storeId   String
  store     Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt, createdAt])
  @@index([storeId, createdAt])
}

model EmployeeNumberAlias {
  id             String @id @default(cuid())
  employeeNumber String @unique
  userId         String
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@index([userId])
}

model Kpi {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  storeId        String
  store          Store    @relation(fields: [storeId], references: [id])
  date           DateTime
  weekNumber     Int?
  weekStart      DateTime?
  weekEnd        DateTime?
  dailySales     Decimal  @db.Decimal(12, 2)
  monthlySales   Decimal  @db.Decimal(12, 2)
  dailyGoal      Decimal  @db.Decimal(12, 2)
  monthlyGoal    Decimal  @db.Decimal(12, 2)
  avgTicket      Decimal  @db.Decimal(12, 2)
  upt            Decimal  @db.Decimal(5, 2)
  conversion     Decimal? @db.Decimal(5, 2)
  traffic        Int?
  pieces         Int
  transactions   Int
  ranking        Int
  grossSales     Decimal? @db.Decimal(12, 2)
  discountAmount Decimal? @db.Decimal(12, 2)
  discountMargin Decimal? @db.Decimal(5, 2)
  discountLimit  Decimal? @db.Decimal(5, 2)
  commissionAmount Decimal @default(0) @db.Decimal(12, 2)
  commissionPercent Decimal @default(0) @db.Decimal(5, 2)
  commissionMinimum Decimal? @db.Decimal(12, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, date])
  @@index([storeId, date])
  @@index([storeId, weekStart, weekNumber])
}

model Schedule {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id])
  storeId   String
  store     Store          @relation(fields: [storeId], references: [id])
  date      DateTime
  day       String
  status    ScheduleStatus @default(WORKING)
  statusRaw String?
  startTime String?
  endTime   String?
  zone      String?
  weekStart DateTime
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([userId, date])
  @@index([storeId, date])
}

model DayPlan {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id])
  storeId   String
  store     Store      @relation(fields: [storeId], references: [id])
  date      DateTime
  dailyGoal Decimal    @db.Decimal(12, 2)
  focus     String
  message   String
  publishedAt DateTime? // null = borrador (solo visible para gerencia hasta enviarlo)
  activities DayPlanTask[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model DayPlanTask {
  id          String   @id @default(cuid())
  planId      String
  plan        DayPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  title       String
  completed   Boolean  @default(false)
  completedAt DateTime?
  autoKey     String?  // null = manual; con valor = actividad operativa generada (CICLICO, BARRER_MOPEAR, ...)
  evidences   Evidence[]
  comments    Comment[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("Activity")
}

model ChoreAssignment {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  date      DateTime
  choreKey  String   // CICLICO | BARRER_MOPEAR | TRAPEAR | VIDRIOS
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, date, choreKey])
  @@index([storeId, choreKey])
}

model Pending {
  id          String          @id @default(cuid())
  storeId     String
  store       Store           @relation(fields: [storeId], references: [id])
  title       String
  description String
  category    PendingCategory
  priority    PendingPriority
  ownerId     String
  owner       User            @relation("PendingOwner", fields: [ownerId], references: [id])
  status      PendingStatus   @default(PENDIENTE)
  dueDate     DateTime
  evidences   Evidence[]
  comments    Comment[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model StoreLog {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id])
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  category    String
  description String
  evidenceUrl String?
  evidences   Evidence[]
  comments    Comment[]
  createdAt   DateTime @default(now())
}

model Evidence {
  id           String       @id @default(cuid())
  storeId      String
  store        Store        @relation(fields: [storeId], references: [id])
  uploadedById String
  uploadedBy   User         @relation("EvidenceAuthor", fields: [uploadedById], references: [id])
  pendingId    String?
  pending      Pending?     @relation(fields: [pendingId], references: [id], onDelete: Cascade)
  logEntryId   String?
  logEntry     StoreLog?    @relation(fields: [logEntryId], references: [id], onDelete: Cascade)
  taskId       String?
  task         DayPlanTask? @relation(fields: [taskId], references: [id], onDelete: Cascade)
  url          String
  fileName     String?
  mimeType     String?
  note         String?
  createdAt    DateTime     @default(now())

  @@index([storeId, pendingId])
  @@index([storeId, taskId])
  @@index([storeId, logEntryId])
}

model Comment {
  id         String       @id @default(cuid())
  storeId    String
  store      Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  authorId   String
  author     User         @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  pendingId  String?
  pending    Pending?     @relation(fields: [pendingId], references: [id], onDelete: Cascade)
  taskId     String?
  task       DayPlanTask? @relation(fields: [taskId], references: [id], onDelete: Cascade)
  logEntryId String?
  logEntry   StoreLog?    @relation(fields: [logEntryId], references: [id], onDelete: Cascade)
  announcementId String?
  announcement   Announcement? @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  body       String
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([storeId, pendingId, createdAt])
  @@index([storeId, taskId, createdAt])
  @@index([storeId, logEntryId, createdAt])
  @@index([storeId, announcementId, createdAt])
}

model CommissionRule {
  id                String   @id @default(cuid())
  storeId           String
  store             Store    @relation(fields: [storeId], references: [id])
  role              Role?
  minSales          Decimal  @default(0) @db.Decimal(12, 2)
  maxSales          Decimal? @db.Decimal(12, 2)
  minAchievement    Decimal  @default(0) @db.Decimal(5, 2)
  maxAchievement    Decimal? @db.Decimal(5, 2)
  commissionPercent Decimal  @default(0) @db.Decimal(5, 2)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Announcement {
  id        String             @id @default(cuid())
  storeId   String
  store     Store              @relation(fields: [storeId], references: [id])
  authorId  String
  author    User               @relation(fields: [authorId], references: [id])
  title     String
  body      String
  imageUrl  String?
  reads     AnnouncementRead[]
  reactions AnnouncementReaction[]
  comments  Comment[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model AnnouncementReaction {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji          String
  createdAt      DateTime     @default(now())

  @@unique([announcementId, userId, emoji])
  @@index([announcementId])
}

model WebAuthnCredential {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String   @unique
  publicKey    String
  counter      BigInt   @default(0)
  transports   String?
  createdAt    DateTime @default(now())

  @@index([userId])
}

model WebAuthnChallenge {
  id        String   @id @default(cuid())
  challenge String   @unique
  userId    String?
  expiresAt DateTime

  @@index([expiresAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model AnnouncementRead {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  readAt         DateTime     @default(now())

  @@unique([announcementId, userId])
}

model KpiTarget {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  metric    String
  value     Decimal  @db.Decimal(12, 2)
  period    String
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, metric, period])
  @@index([storeId])
}

model ChecklistEntry {
  id          String    @id @default(cuid())
  storeId     String
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  date        String    // "2026-06-14" (día retail en zona America/Monterrey)
  section     String    // "APERTURA" | "CIERRE"
  itemKey     String
  completed   Boolean   @default(false)
  note        String?
  evidenceUrl String?
  completedBy String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([storeId, date, itemKey])
  @@index([storeId, date])
}

model DailyNotificationLog {
  id         String   @id @default(cuid())
  employeeId String
  date       String   // formato "2026-06-13" (día retail en zona America/Monterrey)
  type       String   // "MORNING" o "EVENING"
  case       String?  // "A"-"G", "skipped", o null (gerencia / matutina)
  sent       Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@unique([employeeId, date, type])
  @@index([date])
}

model Survey {
  id          String           @id @default(cuid())
  storeId     String
  store       Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  authorId    String
  author      User             @relation("SurveyAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  title       String
  description String?
  anonymous   Boolean          @default(true)
  active      Boolean          @default(true)
  questions   SurveyQuestion[]
  responses   SurveyResponse[]
  createdAt   DateTime         @default(now())

  @@index([storeId, createdAt])
}

model SurveyQuestion {
  id       String         @id @default(cuid())
  surveyId String
  survey   Survey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  text     String
  type     String         @default("RATING") // RATING (1-5) | TEXT
  order    Int            @default(0)
  answers  SurveyAnswer[]

  @@index([surveyId])
}

model SurveyResponse {
  id        String         @id @default(cuid())
  surveyId  String
  survey    Survey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation("SurveyRespondent", fields: [userId], references: [id], onDelete: Cascade)
  answers   SurveyAnswer[]
  createdAt DateTime       @default(now())

  @@unique([surveyId, userId])
  @@index([surveyId])
}

model SurveyAnswer {
  id         String         @id @default(cuid())
  responseId String
  response   SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  questionId String
  question   SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  rating     Int?
  text       String?

  @@index([responseId])
  @@index([questionId])
}

model ChatRoom {
  id        String        @id @default(cuid())
  storeId   String
  store     Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  type      ChatRoomType  @default(DIRECT)
  name      String?
  members   ChatMember[]
  messages  ChatMessage[]
  createdAt DateTime      @default(now())

  @@index([storeId])
}

model ChatMember {
  id       String   @id @default(cuid())
  roomId   String
  room     ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())

  @@unique([roomId, userId])
  @@index([userId])
}

model ChatMessage {
  id          String                @id @default(cuid())
  roomId      String
  room        ChatRoom              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User                  @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body        String
  replyToId   String?
  replyTo     ChatMessage?          @relation("ChatReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies     ChatMessage[]         @relation("ChatReply")
  readBy      ChatMessageRead[]
  deliveredTo ChatMessageDelivery[]
  hiddenFor   ChatMessageHide[]
  reactions   ChatMessageReaction[]
  deletedAt   DateTime?             // eliminado para todos (soft delete)
  createdAt   DateTime              @default(now())

  @@index([roomId, createdAt])
  @@index([replyToId])
}

model ChatMessageRead {
  id        String      @id @default(cuid())
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt    DateTime    @default(now())

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
}

model ChatMessageDelivery {
  id          String      @id @default(cuid())
  messageId   String
  message     ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveredAt DateTime    @default(now())

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
}

model ChatMessageHide {
  id        String      @id @default(cuid())
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  hiddenAt  DateTime    @default(now())

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
}

model ChatMessageReaction {
  id        String      @id @default(cuid())
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime    @default(now())

  @@unique([messageId, userId]) // una reacción por usuario y mensaje (estilo WhatsApp)
  @@index([messageId])
  @@index([userId])
}
