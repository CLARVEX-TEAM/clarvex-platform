  countId String
  concept String
  pieces  Int
  count   CycleCount @relation(fields: [countId], references: [id], onDelete: Cascade)

  @@index([countId])
}

/// Una ronda de inventario: el periodo entre dos conteos físicos.
///
/// Reproduce cómo se lleva hoy a mano —el archivo se llama «1RA RONDA 2026» y
/// arranca con el inventario del 18 de febrero—. Cada inventario cierra la ronda
/// en curso y abre la siguiente, cuya base son las piezas recién contadas.
///
/// ⚠️ **Dentro de una ronda, `basePieces` no se toca JAMÁS.** Es el único número
/// del kardex que no se deriva de nada; todo lo demás se calcula sumándole los
/// movimientos. Corregir la base a media ronda reescribe la existencia teórica
/// de todos los días de golpe. Para absorber una diferencia ya investigada se
/// registra un `AJUSTE`, con motivo obligatorio — la diferencia entre una merma
/// explicada y una desaparecida.
///
/// Solo puede haber **una ronda abierta por tienda**. Lo garantiza un índice
/// único parcial (`closedAt IS NULL`) creado en la migración, no el código: dos
/// rondas abiertas partirían los movimientos en dos kardex incompatibles.
model InventoryRound {
  id            String              @id @default(cuid())
  storeId       String
  /// Cómo la llaman en tienda. Ej. «1ra ronda 2026».
  name          String
  /// Día del inventario que la abre. Los movimientos son POSTERIORES a él.
  startDate     DateTime
  /// Piezas contadas en ese inventario. La base.
  basePieces    Int
  /// Día del inventario que la cierra. `null` mientras está abierta.
  endDate       DateTime?
  /// Piezas contadas al cerrar. Son la base de la ronda siguiente.
  closingPieces Int?
  /// Conteo de la app del que salió la base, si vino de un `CycleCount`.
  countId       String?
  note          String?
  closedAt      DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  store         Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  movements     InventoryMovement[]

  @@unique([storeId, startDate])
  @@index([storeId, startDate])
}

/// Un movimiento de mercancía: el kardex.
///
/// `quantity` SIEMPRE es positivo; el signo lo pone el tipo (ver
/// `signedQuantity` en `lib/inventory-kardex-entry.ts`). Guardar cantidades
/// negativas invita a que un dedazo reste dos veces sin que nada lo delate.
///
/// ⚠️ **La venta del día NO se registra aquí.** Sale de las piezas ya
/// capturadas en `Kpi`, y duplicarla dejaría el teórico bajo. Las devoluciones
/// de cliente sí van aquí: el POS las reporta aparte y las piezas de `Kpi` son
/// brutas, así que no hay doble conteo.
///
/// Nada se sobrescribe ni se borra para corregir: se registra otro movimiento.
/// Un kardex que se puede editar deja de poder explicar su propio número.
model InventoryMovement {
  id              String                @id @default(cuid())
  storeId         String
  /// Ronda a la que pertenece. Un movimiento sin ronda no tiene base contra la
  /// cual significar nada.
  roundId         String
  date            DateTime
  type            InventoryMovementType
  /// Piezas, siempre > 0. El sentido lo da `type`.
  quantity        Int
  /// Caja, folio del traspaso o número de pedido en SFS.
  reference       String?
  /// Manifiesto. Es lo que permite rastrear el envío con Axo.
  document        String?
  /// Entrega, en la recepción de mercancía.
  delivery        String?
  /// Tienda destino/origen, CEDIS, o de dónde vino la mercancía. Es la etiqueta
  /// legible; el APTO va en `counterpartCode`.
  counterpart     String?
  /// APTO del catálogo (`lib/inventory-counterparts.ts`). Sin él, «CUERNAVACA»
  /// puede ser dos tiendas distintas y el traspaso deja de ser rastreable.
  counterpartCode String?
  /// Piezas de más y de menos halladas al abrir la caja. NO entran al teórico
  /// —`quantity` ya son las piezas realmente recibidas—, pero son la primera
  /// pista cuando el conteo de cierre no cuadra.
  surplus         Int?
  missing         Int?
  note            String?
  /// Quién recibe o quién recolecta. Texto libre: la captura entra por API
  /// externa y ahí aparecen tanto personas como paqueterías («ESTAFETA»).
  createdBy       String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  store           Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  round           InventoryRound        @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@index([storeId, date])
  @@index([roundId, date])
}

enum InventoryMovementType {
  RECEPCION
  TRANSFERENCIA_ENTRADA
  DEVOLUCION_CLIENTE
  TRANSFERENCIA_SALIDA
  /// Ship From Store: pedido en línea surtido con mercancía de la tienda.
  SFS
  AJUSTE_POSITIVO
  AJUSTE_NEGATIVO
}

