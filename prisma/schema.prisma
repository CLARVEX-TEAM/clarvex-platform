model CommissionRule {
  id                String   @id @default(cuid())
  storeId           String
  role              Role?
  minSales          Decimal  @default(0) @db.Decimal(12, 2)
  maxSales          Decimal? @db.Decimal(12, 2)
  // TRES decimales, no dos: el tabulador de Guess usa 1.654 %, 2.427 %, 1.230 %…
  // Con el Decimal(5,2) anterior, 2.427 se guardaba redondeado a 2.43 y la
  // comisión salía mal sin que nada fallara. Ampliar la escala no toca las filas
  // existentes (1.53 sigue siendo 1.530).
  commissionPercent Decimal  @default(0) @db.Decimal(6, 3)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  minAchievement    Decimal  @default(0) @db.Decimal(5, 2)
  maxAchievement    Decimal? @db.Decimal(5, 2)

  // Esquema Guess (agosto 2026): los brackets de 80% a 99.99% NO pagan un
  // porcentaje sino un importe fijo, y ese importe cambia entre temporada
  // regular y temporada alta.
  //
  // Los tres campos son aditivos a propósito: con `payoutType = PERCENT` y los
  // importes en null, el cálculo es exactamente el de siempre. Las reglas ya
  // existentes de las demás marcas no cambian de comportamiento.
  payoutType      CommissionPayoutType @default(PERCENT)
  /// Importe fijo en temporada regular. Solo se lee si payoutType = FIXED.
  fixedAmount     Decimal?             @db.Decimal(12, 2)
  /// Importe fijo en temporada alta. Si es null, se usa `fixedAmount`.
  fixedAmountHigh Decimal?             @db.Decimal(12, 2)

  store Store @relation(fields: [storeId], references: [id])
}

/// Rangos de TEMPORADA ALTA por tienda. Un periodo sin fila que lo cubra se
/// paga como temporada regular: es el valor conservador, y al ser el importe
/// notablemente menor, un rango mal capturado se nota enseguida.
model CommissionSeason {
  id        String   @id @default(cuid())
  storeId   String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  label     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  store     Store    @relation(fields: [storeId], references: [id])

  @@index([storeId, startDate, endDate])
}

enum CommissionPayoutType {
  PERCENT
  FIXED
}

enum CommissionBasis {
  MINIMO
  META
}

/// Un comunicado REDACTADO a partir del correo de promociones del corporativo,
/// esperando a que la gerencia lo revise.
///
/// ⚠️ **No es un comunicado: es un borrador.** Vive aparte de `Announcement` a
/// proposito. Meterlo alli con una bandera de «sin publicar» obligaria a
/// acordarse del filtro en las seis consultas que leen comunicados hoy, y la
/// que se olvidara publicaria una promocion sin revisar a toda la tienda. Aqui
/// no puede pasar: quien lee comunicados no ve esta tabla.
model PromoDraft {
  id        String    @id @default(cuid())
  storeId   String
  /// Titulo y cuerpo ya armados con la plantilla fija de `promo-comunicado.ts`.
  title     String
  body      String
  /// Los campos tal como los devolvio la lectura, por si hay que revisarla.
  datos     Json
  /// Cuando la gerencia lo usa deja de ofrecerse. No se borra: si el comunicado
  /// sale mal, el borrador es lo unico que dice que decia el correo.
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, usedAt])
}

model Announcement {
  id        String                 @id @default(cuid())
  storeId   String
  authorId  String
  title     String
  body      String
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  imageUrl  String?
  author    User                   @relation(fields: [authorId], references: [id])
  store     Store                  @relation(fields: [storeId], references: [id])
  reactions AnnouncementReaction[]
  reads     AnnouncementRead[]
  comments  Comment[]
}

model AnnouncementReaction {
  id             String       @id @default(cuid())
  announcementId String
  userId         String
  emoji          String
  createdAt      DateTime     @default(now())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId, emoji])
  @@index([announcementId])
}

model WebAuthnCredential {
  id           String   @id @default(cuid())
  userId       String
  credentialId String   @unique
  publicKey    String
  counter      BigInt   @default(0)
  transports   String?
  /// Dominio donde se registró (el «RP ID» de WebAuthn).
  ///
  /// ⚠️ Una credencial vale SOLO en su dominio: es una garantía del estándar,
  /// no un detalle de implementación — impide que un sitio falso reutilice una
  /// huella. Sin guardarlo, al mudar de dominio la app seguía ofreciendo
  /// «Entrar con huella» y el teléfono respondía «no hay llaves de acceso», un
  /// error incomprensible para quien lo vive.
  ///
  /// Nulo = registrada antes de que esto existiera, o sea en el dominio viejo.
  rpId         String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, rpId])
}

model WebAuthnChallenge {
  id        String   @id @default(cuid())
  challenge String   @unique
  userId    String?
  expiresAt DateTime

  @@index([expiresAt])
}

/// Enlace de un solo uso para restablecer el PIN por correo.
///
/// Se guarda el SHA-256 del token, NUNCA el token en claro: quien logre leer
/// esta tabla (un volcado, un respaldo filtrado, un SELECT de más) no puede
/// fabricar el enlace. Es el mismo criterio que con el PIN — la base guarda una
/// huella, no la credencial.
///
/// `usedAt` no se borra al consumirlo a propósito: deja rastro de que el enlace
/// se usó y cuándo, y evita que un reintento del mismo enlace vuelva a servir.
model PinResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  /// Para auditar de dónde salió la solicitud. No identifica por sí solo.
  requestIp String?

  @@index([userId])
  @@index([expiresAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Aparato Android que recibe notificaciones por FCM, desde la app de la Play
/// Store. Es hermano de `PushSubscription`, no su sustituto: la PWA y el
/// navegador siguen entrando por Web Push con VAPID.
///
/// ⚠️ Son DOS tablas y no una a proposito. Una suscripcion de Web Push es una
/// terna endpoint/p256dh/auth que se cifra en el servidor; un token de FCM es
/// una cadena opaca que se manda a Google. Meterlos juntos obligaria a dejar
/// tres columnas anulables y a distinguirlos por una bandera, que es como se
/// acaba mandando una carga cifrada a quien no la puede abrir.
///
/// ⚠️ El token es UNICO y puede CAMBIAR DE DUENO. Google lo reasigna al
/// reinstalar la app o al borrar sus datos, asi que la clave natural es el
/// token y el `userId` se sobrescribe al registrarlo: si dos personas comparten
/// el telefono de la tienda, la ultima que entra es la que recibe. Guardarlo
/// por (usuario, token) dejaria al anterior recibiendo las notificaciones de
/// alguien mas en un aparato que ya no es suyo.
model DeviceToken {
  id             String        @id @default(cuid())
  userId         String
  /// El registration token de FCM. Identifica al aparato, no a la persona.
  token          String        @unique
  /// "android" hoy. Existe para no tener que migrar cuando llegue iOS.
  platform       String
  /// El versionCode de la app instalada. Es el unico orden fiable: `appVersion`
  /// es "1.10" y comparado como texto queda por debajo de "1.9".
  ///
  /// Opcional a proposito: los aparatos registrados ANTES de esta columna no lo
  /// tienen y no se puede inventar. Se rellena solo en el siguiente arranque.
  appBuild       Int?
  /// Lo que se le ensena a una persona: "1.3".
  appVersion     String?
  /// Instalación criptográfica que posee este token. Opcional para conservar
  /// los registros de APK anteriores a la identidad nativa.
  nativeDeviceId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  nativeDevice   NativeDevice? @relation(fields: [nativeDeviceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([nativeDeviceId])
}

/// Instalación Android identificada por una llave EC no exportable del
/// Android Keystore. La sesión identifica a la persona; esta fila demuestra
/// además qué instalación firmó una operación exclusiva de la APK.
model NativeDevice {
  id             String        @id @default(cuid())
  installationId String        @unique
  publicKey      String
  keyAlgorithm   String        @default("ES256")
  userId         String
  storeId        String
  profile        String        @default("PERSONAL")
  appBuild       Int
  appVersion     String
  capabilities   Json
  status         String        @default("ACTIVE")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  lastSeenAt     DateTime      @default(now())
  revokedAt      DateTime?
  /// Última salud reportada por el equipo: WebView, almacenamiento, red,
  /// cámara, notificaciones y hora automática. `null` mientras no reporte.
  ///
  /// Se guarda como JSON y NO en columnas: lo que se mide va a cambiar --hoy
  /// son siete cosas, mañana ocho-- y una migración por cada una es una
  /// migración que nadie va a querer hacer. Lo que se CONSULTA de verdad, que
  /// es si algo está mal, se decide en `lib/salud-equipo.ts`.
  health         Json?
  healthAt       DateTime?
  /// Procedencia del binario. Ver `lib/atestacion.ts`.
  ///
  /// ⚠️ Se publica en modo OBSERVAR: se recoge y se enseña, pero NO bloquea.
  /// Encenderlo antes de ver qué reportan los equipos reales dejaría fuera a
  /// quien trabaja, que es el riesgo de verdad de esta función.
  provenance     String        @default("PENDIENTE")
  /// Lo que dijo la última cadena: resultado, motivo y huella de la raíz.
  attestation    Json?
  attestationAt  DateTime?
  /// Quién y cuándo lo aprobó a mano, cuando el equipo no puede atestiguar.
  approvedById   String?
  approvedAt     DateTime?
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  store          Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  deviceTokens   DeviceToken[]

  @@index([userId, status])
  @@index([storeId, status])
}

/// Nonce de un solo uso para altas y peticiones firmadas. No se relaciona con
/// NativeDevice porque REGISTER ocurre antes de que esa fila exista.
model NativeDeviceChallenge {
  id             String    @id @default(cuid())
  installationId String
  userId         String
  storeId        String
  purpose        String
  nonce          String    @unique
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([installationId, purpose, expiresAt])
  @@index([userId, createdAt])
}

model AnnouncementRead {
  id             String       @id @default(cuid())
  announcementId String
  userId         String
  readAt         DateTime     @default(now())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id])

