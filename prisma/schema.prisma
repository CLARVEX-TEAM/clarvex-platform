generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Store {
  id                             String                        @id @default(cuid())
  name                           String
  createdAt                      DateTime                      @default(now())
  updatedAt                      DateTime                      @updatedAt
  billingExempt                  Boolean                       @default(true)
  subscriptionPaidUntil          DateTime?
  pricePerUserMxn                Decimal?                      @db.Decimal(10, 2)
  /// Etiqueta del tabulador de comisiones de la tienda (E, D, C…). En GUESS los
  /// importes cambian según esta letra, así que se guarda tal como la capturó la
  /// tienda para poder contrastarla después con el documento de central. NO
  /// interviene en el cálculo: la comisión sale de las CommissionRule.
  commissionTier                 String?
  /// Contra qué se mide el alcance de comisión.
  ///
  /// `MINIMO` (venta ÷ mínimo) es el histórico y el valor por defecto, así que
  /// las tiendas que ya existen no cambian de comportamiento. `META`
  /// (venta ÷ meta) lo usa GUESS: su propio RDV lo dice literalmente
  /// —«Cumpl % = Venta / Meta»— y con el otro denominador un 90 % de meta
  /// saltaría al tramo de porcentaje y pagaría menos de la mitad.
  ///
  /// El valor por defecto es el conservador a propósito: si alguien da de alta
  /// una tienda y olvida configurarlo, se comporta como siempre.
  commissionBasis                CommissionBasis               @default(MINIMO)
  /// Interruptor para ocultar la sección de KPIs a una tienda.
  ///
  /// Existe porque un KPI vacío no es neutro: una pantalla llena de ceros se
  /// lee como «vendimos cero», no como «todavía no hay datos». Cuando una
  /// tienda no tiene su RDV sincronizado, es más honesto no enseñar nada que
  /// enseñar números que no significan nada.
  ///
  /// Es una bandera y no una condición deducida a propósito: se enciende y se
  /// apaga sin desplegar, y no ata un estado temporal a la marca de la tienda.
  kpisEnabled                    Boolean                       @default(true)
  /// Formulario oficial de asistencia de AXO para esta tienda. Clarvex no lee
  /// sus respuestas: solo prepara la captura, abre este enlace y registra la
  /// confirmación diaria de gerencia.
  attendanceFormUrl              String?
  /// Activa el recordatorio de checklist de energía de lunes, miércoles y
  /// viernes. Es por tienda porque no todas operan este control externo.
  energyChecklistReminderEnabled Boolean                       @default(false)
  announcements                  Announcement[]
  chatRooms                      ChatRoom[]
  checklistEntries               ChecklistEntry[]
  checklistScans                 ChecklistScan[]
  checklistItems                 ChecklistItem[]
  choreAssignments               ChoreAssignment[]
  comments                       Comment[]
  commissionRules                CommissionRule[]
  commissionSeasons              CommissionSeason[]
  cycleCounts                    CycleCount[]
  inventoryRounds                InventoryRound[]
  inventoryMovements             InventoryMovement[]
  cycleCountTags                 CycleCountTag[]
  dataSources                    DataSource[]
  plans                          DayPlan[]
  evidences                      Evidence[]
  inventoryReports               InventoryReport[]
  kpis                           Kpi[]
  kpiTargets                     KpiTarget[]
  kudos                          Kudo[]
  notifications                  Notification[]
  pendings                       Pending[]
  schedules                      Schedule[]
  attendances                    Attendance[]
  shiftSwaps                     ShiftSwap[]
  uniformDays                    UniformDay[]
  shiftRequests                  ShiftRequest[]
  fixtures                       StoreFixture[]
  logEntries                     StoreLog[]
  subscriptionPayments           SubscriptionPayment[]
  surveys                        Survey[]
  trainingResources              TrainingResource[]
  users                          User[]
  aiMemories                     AiMemory[]
  aiPlanHistories                AiPlanHistory[]
  aiRecommendations              AiRecommendationHistory[]
  aiDailySummaries               AiDailySummary[]
  retailAlertLogs                RetailAlertLog[]
  reportDeliveries               ReportDelivery[]
  weeklyPerformanceCloses        WeeklyPerformanceClose[]
  promoDrafts                    PromoDraft[]
  nativeDevices                  NativeDevice[]
  attendanceCorrectionRequests   AttendanceCorrectionRequest[]
}

model StoreFixture {
  id        String   @id @default(cuid())
  storeId   String
  name      String
  col       Int      @default(1)
  row       Int      @default(1)
  styles    String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  type      String   @default("TABLE")
  rotation  Int      @default(0)
  posX      Float    @default(0)
  posZ      Float    @default(0)
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

model DataSource {
  id         String              @id @default(cuid())
  storeId    String
  type       DataSourceType
  provider   DataSourceProvider  @default(MANUAL)
  name       String
  url        String?
  status     DataSourceStatus    @default(DISCONNECTED)
  lastSyncAt DateTime?
  nextSyncAt DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  frequency  DataSourceFrequency @default(MANUAL)
  store      Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  syncLogs   SyncLog[]

  @@unique([storeId, type])
  @@index([storeId, status])
}

model SyncLog {
  id               String        @id @default(cuid())
  dataSourceId     String
  status           SyncLogStatus
  message          String
  recordsProcessed Int           @default(0)
  createdAt        DateTime      @default(now())
  dataSource       DataSource    @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)

  @@index([dataSourceId, createdAt])
}

model User {
  id                            String                        @id @default(cuid())
  name                          String
  email                         String                        @unique
  employeeNumber                String                        @unique
  passwordHash                  String?
  role                          Role
  storeId                       String
  createdAt                     DateTime                      @default(now())
  updatedAt                     DateTime                      @updatedAt
  pinHash                       String?
  photoUrl                      String?
  biometricEnabled              Boolean                       @default(false)
  lastLoginAt                   DateTime?
  birthDate                     DateTime?
  hireDate                      DateTime?
  hoursOwed                     Float                         @default(0)
  /// Fecha de corte del banco de horas: `hoursOwed` ya cubre todo lo anterior.
  /// Sin ella se sumaria dos veces el historico cada vez que alguien ajusta el
  /// saldo a mano — la misma frontera que `vacationBaselineAt`.
  hoursBaselineAt               DateTime?
  /// Saldo de vacaciones capturado a mano. NO es el saldo real: el que manda lo
  /// calcula lib/vacation-account (este + lo ganado en aniversarios − lo tomado).
  vacationDays                  Float                         @default(0)
  /// Fecha de corte del saldo de arriba: lo anterior a ella YA está descontado.
  /// Sin esta frontera, las vacaciones viejas se restarían dos veces.
  vacationBaselineAt            DateTime?
  paidDays                      Float                         @default(0)
  /// Fecha de corte del saldo de pago de días: lo capturado en `paidDays` ya
  /// cubre todo lo anterior. Sin ella se recontarían semanas viejas y el saldo
  /// saldría inflado — la misma frontera que `vacationBaselineAt`.
  paidDaysBaselineAt            DateTime?
  lastSeenAt                    DateTime?
  active                        Boolean                       @default(true)
  platformAdmin                 Boolean                       @default(false)
  /// Usuario "kiosko" del celular de la tienda: SOLO ve el checklist (para los
  /// escaneos del cierre). El middleware lo encierra en /checklist.
  checklistOnly                 Boolean                       @default(false)
  /// Usuario de DEMOSTRACIÓN (tienda demo pública). Su sesión es de SOLO
  /// LECTURA: el middleware corta cualquier método que no sea GET.
  isDemo                        Boolean                       @default(false)
  failedPinAttempts             Int                           @default(0)
  pinLockedUntil                DateTime?
  pinLockoutCount               Int                           @default(0)
  sessionVersion                Int                           @default(0)
  termsAcceptedAt               DateTime?
  termsAcceptedVersion          String?
  /// Qué columna del uniforme le toca: MUJER | HOMBRE. No registra identidad:
  /// solo decide qué playera le corresponde (el martes ellas de negro, ellos de blanco).
  uniformVariant                String?
  authoredAnnouncements         Announcement[]
  announcementReactions         AnnouncementReaction[]
  announcementReads             AnnouncementRead[]
  chatMemberships               ChatMember[]
  chatMessages                  ChatMessage[]
  chatMessageDeliveries         ChatMessageDelivery[]
  chatMessageHides              ChatMessageHide[]
  chatMessageReactions          ChatMessageReaction[]
  chatMessageReads              ChatMessageRead[]
  chatMentions                  ChatMention[]
  choreAssignments              ChoreAssignment[]
  comments                      Comment[]                     @relation("CommentAuthor")
  plans                         DayPlan[]
  employeeNumberAliases         EmployeeNumberAlias[]
  evidences                     Evidence[]                    @relation("EvidenceAuthor")
  inventoryReports              InventoryReport[]             @relation("InventoryReporter")
  inventoryResolved             InventoryReport[]             @relation("InventoryResolver")
  kpis                          Kpi[]
  kudosSent                     Kudo[]                        @relation("KudoFrom")
  kudosReceived                 Kudo[]                        @relation("KudoTo")
  notifications                 Notification[]
  assignedPendings              Pending[]                     @relation("PendingOwner")
  pushSubscriptions             PushSubscription[]
  deviceTokens                  DeviceToken[]
  schedules                     Schedule[]
  attendances                   Attendance[]
  shiftRequests                 ShiftRequest[]                @relation("ShiftRequester")
  swapsRequested                ShiftSwap[]                   @relation("SwapRequester")
  swapsReceived                 ShiftSwap[]                   @relation("SwapTarget")
  authoredLogs                  StoreLog[]
  authoredSurveys               Survey[]                      @relation("SurveyAuthor")
  surveyResponses               SurveyResponse[]              @relation("SurveyRespondent")
  authoredTraining              TrainingResource[]            @relation("TrainingAuthor")
  trainingViews                 TrainingResourceView[]        @relation("TrainingViewer")
  legalAcceptances              LegalAcceptance[]
  store                         Store                         @relation(fields: [storeId], references: [id])
  webAuthnCredentials           WebAuthnCredential[]
  aiMemories                    AiMemory[]
  aiPlanHistories               AiPlanHistory[]
  aiRecommendations             AiRecommendationHistory[]
  retailAlertLogs               RetailAlertLog[]
  reportDeliveries              ReportDelivery[]
  pinResetTokens                PinResetToken[]
  nativeDevices                 NativeDevice[]
  attendanceCorrectionRequests  AttendanceCorrectionRequest[]
  reviewedAttendanceCorrections AttendanceCorrectionRequest[] @relation("AttendanceCorrectionReviewer")
}

model TrainingResource {
  id          String                 @id @default(cuid())
  storeId     String
  authorId    String
  title       String
  description String?
  category    String
  linkUrl     String?
  fileUrl     String?
  fileName    String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  author      User                   @relation("TrainingAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  store       Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  views       TrainingResourceView[]

  @@index([storeId, createdAt])
}

model TrainingResourceView {
  id         String           @id @default(cuid())
  resourceId String
  userId     String
  viewedAt   DateTime         @default(now())
  resource   TrainingResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user       User             @relation("TrainingViewer", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([resourceId, userId])
  @@index([resourceId])
}

model InventoryReport {
  id           String    @id @default(cuid())
  storeId      String
  reporterId   String
  productName  String
  category     String
  note         String?
  photoUrl     String?
  status       String    @default("ABIERTO")
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  reporter     User      @relation("InventoryReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy   User?     @relation("InventoryResolver", fields: [resolvedById], references: [id])
  store        Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, status, createdAt])
}

model ShiftRequest {
  id           String    @id @default(cuid())
  storeId      String
  requesterId  String
  date         String
  type         String
  reason       String?
  status       String    @default("PENDIENTE")
  resolvedById String?
  resolvedAt   DateTime?
  managerNote  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  hours        Float?
  requester    User      @relation("ShiftRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  store        Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, status, date])
  @@index([requesterId, createdAt])
}

model Kudo {
  id         String   @id @default(cuid())
  storeId    String
  fromUserId String
  toUserId   String
  emoji      String
  message    String?
  createdAt  DateTime @default(now())
  fromUser   User     @relation("KudoFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  toUser     User     @relation("KudoTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
  @@index([toUserId, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  storeId   String
  userId    String
  type      NotificationType
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime         @default(now())
  store     Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([storeId, createdAt])
}

model EmployeeNumberAlias {
  id             String   @id @default(cuid())
  employeeNumber String   @unique
  userId         String
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Kpi {
  id                   String    @id @default(cuid())
  userId               String
  storeId              String
  date                 DateTime
  dailySales           Decimal   @db.Decimal(12, 2)
  monthlySales         Decimal   @db.Decimal(12, 2)
  dailyGoal            Decimal   @db.Decimal(12, 2)
  monthlyGoal          Decimal   @db.Decimal(12, 2)
  avgTicket            Decimal   @db.Decimal(12, 2)
  upt                  Decimal   @db.Decimal(5, 2)
  conversion           Decimal?  @db.Decimal(5, 2)
  pieces               Int
  transactions         Int
  ranking              Int
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  discountMargin       Decimal?  @db.Decimal(5, 2)
  commissionAmount     Decimal   @default(0) @db.Decimal(12, 2)
  commissionPercent    Decimal   @default(0) @db.Decimal(5, 2)
  grossSales           Decimal?  @db.Decimal(12, 2)
  discountAmount       Decimal?  @db.Decimal(12, 2)
  discountLimit        Decimal?  @db.Decimal(5, 2)
  /// El bruto y el descuento de ESTA fila son del día, no el total de la semana
  /// puesto en la fila ancla. Distingue las dos formas de capturar el margen y
  /// permite negarse a mezclarlas: sumar un total semanal más los días sueltos
  /// de esa misma semana infla el descuento sin que nada avise.
  discountDaily        Boolean   @default(false)
  weekNumber           Int?
  weekStart            DateTime?
  weekEnd              DateTime?
  traffic              Int?
  commissionMinimum    Decimal?  @db.Decimal(12, 2)
  orkestraSales        Decimal?  @db.Decimal(12, 2)
  orkestraTransactions Int?
  orkestraPieces       Int?
  /// Tickets electrónicos de la SEMANA (captura manual de gerencia desde Centro
  /// de Datos; el POS no exporta). Como el margen DTO, vive SOLO en la fila
  /// ancla —el primer día de la semana— y en el resto queda null: si se
  /// repitiera en los 7 días, sumar la semana multiplicaría por siete.
  crmTransactions      Int?
  /// Tickets totales de la semana SEGÚN EL POS. Normalmente se deja vacío y
  /// manda la suma de `transactions` del RDV; se captura solo cuando el POS no
  /// cuadra con el RDV, para que la tasa no mezcle dos fuentes.
  posTransactions      Int?
  store                Store     @relation(fields: [storeId], references: [id])
  user                 User      @relation(fields: [userId], references: [id])

  @@unique([userId, date])
  @@index([storeId, date])
  @@index([storeId, weekStart, weekNumber])
}

model Schedule {
  id        String         @id @default(cuid())
  userId    String
  storeId   String
  day       String
  startTime String?
  endTime   String?
  zone      String?
  weekStart DateTime
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  date      DateTime
  status    ScheduleStatus @default(WORKING)
  statusRaw String?
  store     Store          @relation(fields: [storeId], references: [id])
  user      User           @relation(fields: [userId], references: [id])

  @@unique([userId, date])
  @@index([storeId, date])
}

/// Copia auditable de la Cuota Justa y del cierre semanal de una tienda.
/// El snapshot se congela al finalizar para que capturas posteriores de KPIs
/// no cambien silenciosamente un cierre ya entregado.
model WeeklyPerformanceClose {
  id             String                  @id @default(cuid())
  storeId        String
  weekStart      DateTime                @db.Date
  weekEnd        DateTime                @db.Date
  weekNumber     Int
  status         WeeklyPerformanceStatus @default(DRAFT)
  upliftPercent  Decimal                 @default(15) @db.Decimal(5, 2)
  whatsappBudget Decimal                 @default(0) @db.Decimal(12, 2)
  plan           Json
  snapshot       Json?
  quotaSavedAt   DateTime?
  quotaSavedBy   String?
  reportSnapshot Json?
  reportSavedAt  DateTime?
  reportSavedBy  String?
  note           String?
  createdBy      String
  updatedBy      String
  finalizedBy    String?
  finalizedAt    DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  store          Store                   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, weekStart])
  @@index([storeId, status, weekStart])
}

/// Uniforme que toca cada día de la semana. Editable por gerencia: los uniformes
/// cambian con las temporadas y no se puede depender de un despliegue para
/// cambiar "roja" por "guinda".
///
/// Si una tienda no tiene filas, la app usa la tabla por defecto de
/// lib/uniforms.ts. La primera edición las crea.
model UniformDay {
  id          String   @id @default(cuid())
  storeId     String
  /// 0 = domingo … 6 = sábado (igual que Date.getUTCDay()).
  weekday     Int
  womanTop    String
  womanBottom String
  manTop      String
  manBottom   String
  /// Nota del día (p. ej. "El sábado es día formal").
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, weekday])
}

/// Intercambio de descansos entre dos asesores.
///
/// Hoy esto vive en WhatsApp y en la memoria de gerencia — y de ahí salió un bug
/// real (se editó el Drive a mano y el ranking mostraba a los dos laborando).
///
/// La app COORDINA (propuesta → el compañero acepta → gerencia autoriza) pero NO
/// escribe el horario: la fuente de verdad sigue siendo el archivo de Horarios.
/// Al aprobarse, la app le dice a gerencia exactamente qué cambiar en el Drive, y
/// detecta sola cuándo ya quedó (driveUpdated).
model ShiftSwap {
  id            String    @id @default(cuid())
  storeId       String
  /// Quien propone el cambio.
  requesterId   String
  /// El día que HOY descansa el proponente ("YYYY-MM-DD") y cede.
  requesterDate String
  /// Con quién se cambia.
  targetId      String
  /// El día que HOY descansa el compañero y cede.
  targetDate    String
  reason        String?
  /// PENDIENTE_COMPANERO → PENDIENTE_GERENCIA → APROBADO | RECHAZADO
  status        String    @default("PENDIENTE_COMPANERO")
  /// Cuándo respondió el compañero.
  respondedAt   DateTime?
  resolvedById  String?
  resolvedAt    DateTime?
  managerNote   String?
  /// El archivo de Horarios ya refleja el cambio. Se marca solo al sincronizar.
  driveUpdated  Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  store         Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  requester     User      @relation("SwapRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  target        User      @relation("SwapTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@index([storeId, status])
  @@index([targetId, status])
}

/// Asistencia diaria: la foto de un día que la hoja APERTURA sobrescribe.
/// La hoja solo guarda el día en curso, así que el cron la baja varias veces al
/// día y la conserva aquí. De esta tabla salen los reportes de nómina (faltas
/// quincenales; retardos, domingos y festivos mensuales).
model Attendance {
  id              String           @id @default(cuid())
  storeId         String
  userId          String
  date            DateTime
  /// Hora que debía entrar ("10:30"), tomada del horario del día.
  expectedAt      String?
  /// Hora que marcó en el POS ("10:45"). null = no marcó entrada.
  arrivedAt       String?
  lunchStart      String?
  leftAt          String?
  /// Hora en que debía salir ("21:00"). Para el banco de horas.
  expectedLeaveAt String?
  /// Diferencia contra su horario. Negativo = llegó antes.
  minutesLate     Int              @default(0)
  /// Saldo del día en minutos (ver lib/hours-balance). Positivo = a su favor.
  minutesBalance  Int              @default(0)
  status          AttendanceStatus
  /// Texto crudo de la celda de entrada cuando no era una hora ("VACACIONES").
  entryText       String?
  /// APERTURA_XLSX (del archivo) o MANUAL (corregido por gerencia).
  source          String           @default("APERTURA_XLSX")
  /// Nota de la corrección manual. Quién y cuándo va en AuditLog.
  note            String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  store           Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id])

  @@unique([userId, date])
  @@index([storeId, date])
}

/// Solicitud hecha desde la APK para corregir una entrada de asistencia.
/// La captura original nunca se pisa al solicitar: gerencia revisa y la
/// aprobación aplica el cambio en Attendance dentro de la misma transacción.
model AttendanceCorrectionRequest {
  id                 String           @id @default(cuid())
  storeId            String
  userId             String
  date               DateTime         @db.Date
  requestedStatus    AttendanceStatus
  requestedArrivedAt String?
  requestedLeftAt    String?
  reason             String
  evidenceUrl        String?
  status             String           @default("PENDING")
  managerNote        String?
  reviewedById       String?
  reviewedAt         DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  store              Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  reviewedBy         User?            @relation("AttendanceCorrectionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([storeId, status, createdAt])
  @@index([userId, date, createdAt])
}

enum AttendanceStatus {
  ON_TIME
  LATE
  ABSENT
  EXCUSED
  REST
  VACATION
  PAID_DAY
  INVENTORY
}

model DayPlan {
  id          String        @id @default(cuid())
  userId      String
  storeId     String
  date        DateTime
  dailyGoal   Decimal       @db.Decimal(12, 2)
  focus       String
  message     String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  publishedAt DateTime?
  activities  DayPlanTask[]
  store       Store         @relation(fields: [storeId], references: [id])
  user        User          @relation(fields: [userId], references: [id])
}

model DayPlanTask {
  id          String     @id @default(cuid())
  planId      String
  title       String
  completed   Boolean    @default(false)
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  autoKey     String?
  plan        DayPlan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  comments    Comment[]
  evidences   Evidence[]

  @@map("Activity")
}

model ChoreAssignment {
  id        String   @id @default(cuid())
  storeId   String
  date      DateTime
  choreKey  String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, date, choreKey])
  @@index([storeId, choreKey])
}

model Pending {
  id          String          @id @default(cuid())
  storeId     String
  title       String
  description String
  category    PendingCategory
  priority    PendingPriority
  ownerId     String
  status      PendingStatus   @default(PENDIENTE)
  dueDate     DateTime
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  comments    Comment[]
  evidences   Evidence[]
  owner       User            @relation("PendingOwner", fields: [ownerId], references: [id])
  store       Store           @relation(fields: [storeId], references: [id])
}

model StoreLog {
  id          String     @id @default(cuid())
  storeId     String
  authorId    String
  category    String
