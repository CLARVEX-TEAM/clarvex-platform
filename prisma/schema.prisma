generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Store {
  id                    String                @id @default(cuid())
  name                  String
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  billingExempt         Boolean               @default(true)
  subscriptionPaidUntil DateTime?
  pricePerUserMxn       Decimal?              @db.Decimal(10, 2)
  announcements         Announcement[]
  chatRooms             ChatRoom[]
  checklistEntries      ChecklistEntry[]
  choreAssignments      ChoreAssignment[]
  comments              Comment[]
  commissionRules       CommissionRule[]
  cycleCounts           CycleCount[]
  cycleCountTags        CycleCountTag[]
  dataSources           DataSource[]
  plans                 DayPlan[]
  evidences             Evidence[]
  inventoryReports      InventoryReport[]
  kpis                  Kpi[]
  kpiTargets            KpiTarget[]
  kudos                 Kudo[]
  notifications         Notification[]
  pendings              Pending[]
  schedules             Schedule[]
  shiftRequests         ShiftRequest[]
  fixtures              StoreFixture[]
  logEntries            StoreLog[]
  subscriptionPayments  SubscriptionPayment[]
  surveys               Survey[]
  trainingResources     TrainingResource[]
  users                 User[]
  aiMemories             AiMemory[]
  aiPlanHistories        AiPlanHistory[]
  aiRecommendations      AiRecommendationHistory[]
  aiDailySummaries       AiDailySummary[]
  retailAlertLogs        RetailAlertLog[]
  powerBiConnection      StorePowerBiConnection?
}

model StorePowerBiConnection {
  id                    String   @id @default(cuid())
  storeId               String   @unique
  msAccountEmail        String?
  encryptedRefreshToken String
  exportUrl             String
  exportPayloadTemplate Json
  connectedByUserId     String?
  connectedAt           DateTime @default(now())
  updatedAt             DateTime @updatedAt
  store                 Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  connectedBy           User?    @relation("PowerBiConnectedBy", fields: [connectedByUserId], references: [id], onDelete: SetNull)

  @@index([connectedByUserId])
}

model StoreFixture {
  id        String   @id @default(cuid())
  storeId   String
  name      String
  col       Int      @default(1)
  row       Int      @default(1)
  styles    String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  type      String   @default("TABLE")
  rotation  Int      @default(0)
  posX      Float    @default(0)
  posZ      Float    @default(0)
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

model DataSource {
  id         String              @id @default(cuid())
  storeId    String
  type       DataSourceType
  provider   DataSourceProvider  @default(MANUAL)
  name       String
  url        String?
  status     DataSourceStatus    @default(DISCONNECTED)
  lastSyncAt DateTime?
  nextSyncAt DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  frequency  DataSourceFrequency @default(MANUAL)
  store      Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  syncLogs   SyncLog[]

  @@unique([storeId, type])
  @@index([storeId, status])
}

model SyncLog {
  id               String        @id @default(cuid())
  dataSourceId     String
  status           SyncLogStatus
  message          String
  recordsProcessed Int           @default(0)
  createdAt        DateTime      @default(now())
  dataSource       DataSource    @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)

  @@index([dataSourceId, createdAt])
}

model User {
  id                    String                 @id @default(cuid())
  name                  String
  email                 String                 @unique
  employeeNumber        String                 @unique
  passwordHash          String?
  role                  Role
  storeId               String
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  pinHash               String?
  photoUrl              String?
  biometricEnabled      Boolean                @default(false)
  lastLoginAt           DateTime?
  birthDate             DateTime?
  hireDate              DateTime?
  hoursOwed             Float                  @default(0)
  vacationDays          Float                  @default(0)
  paidDays              Float                  @default(0)
  lastSeenAt            DateTime?
  active                Boolean                @default(true)
  platformAdmin         Boolean                @default(false)
  failedPinAttempts     Int                    @default(0)
  pinLockedUntil        DateTime?
  pinLockoutCount       Int                    @default(0)
  sessionVersion        Int                    @default(0)
  termsAcceptedAt       DateTime?
  termsAcceptedVersion  String?
  authoredAnnouncements Announcement[]
  announcementReactions AnnouncementReaction[]
  announcementReads     AnnouncementRead[]
  chatMemberships       ChatMember[]
  chatMessages          ChatMessage[]
  chatMessageDeliveries ChatMessageDelivery[]
  chatMessageHides      ChatMessageHide[]
  chatMessageReactions  ChatMessageReaction[]
  chatMessageReads      ChatMessageRead[]
  choreAssignments      ChoreAssignment[]
  comments              Comment[]              @relation("CommentAuthor")
  plans                 DayPlan[]
  employeeNumberAliases EmployeeNumberAlias[]
  evidences             Evidence[]             @relation("EvidenceAuthor")
  inventoryReports      InventoryReport[]      @relation("InventoryReporter")
  inventoryResolved     InventoryReport[]      @relation("InventoryResolver")
  kpis                  Kpi[]
  kudosSent             Kudo[]                 @relation("KudoFrom")
  kudosReceived         Kudo[]                 @relation("KudoTo")
  notifications         Notification[]
  assignedPendings      Pending[]              @relation("PendingOwner")
  pushSubscriptions     PushSubscription[]
  schedules             Schedule[]
  shiftRequests         ShiftRequest[]         @relation("ShiftRequester")
  authoredLogs          StoreLog[]
  authoredSurveys       Survey[]               @relation("SurveyAuthor")
  surveyResponses       SurveyResponse[]       @relation("SurveyRespondent")
  authoredTraining      TrainingResource[]     @relation("TrainingAuthor")
  trainingViews         TrainingResourceView[] @relation("TrainingViewer")
  store                 Store                  @relation(fields: [storeId], references: [id])
  webAuthnCredentials   WebAuthnCredential[]
  aiMemories             AiMemory[]
  aiPlanHistories        AiPlanHistory[]
  aiRecommendations      AiRecommendationHistory[]
  retailAlertLogs        RetailAlertLog[]
  powerBiConnections     StorePowerBiConnection[] @relation("PowerBiConnectedBy")
}

model TrainingResource {
  id          String                 @id @default(cuid())
  storeId     String
  authorId    String
  title       String
  description String?
  category    String
  linkUrl     String?
  fileUrl     String?
  fileName    String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  author      User                   @relation("TrainingAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  store       Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  views       TrainingResourceView[]

  @@index([storeId, createdAt])
}

model TrainingResourceView {
  id         String           @id @default(cuid())
  resourceId String
  userId     String
  viewedAt   DateTime         @default(now())
  resource   TrainingResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user       User             @relation("TrainingViewer", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([resourceId, userId])
  @@index([resourceId])
}

model InventoryReport {
  id           String    @id @default(cuid())
  storeId      String
  reporterId   String
  productName  String
  category     String
  note         String?
  photoUrl     String?
  status       String    @default("ABIERTO")
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  reporter     User      @relation("InventoryReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy   User?     @relation("InventoryResolver", fields: [resolvedById], references: [id])
  store        Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, status, createdAt])
}

model ShiftRequest {
  id           String    @id @default(cuid())
  storeId      String
  requesterId  String
  date         String
  type         String
  reason       String?
  status       String    @default("PENDIENTE")
  resolvedById String?
  resolvedAt   DateTime?
  managerNote  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  hours        Float?
  requester    User      @relation("ShiftRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  store        Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, status, date])
  @@index([requesterId, createdAt])
}

model Kudo {
  id         String   @id @default(cuid())
  storeId    String
  fromUserId String
  toUserId   String
  emoji      String
  message    String?
  createdAt  DateTime @default(now())
  fromUser   User     @relation("KudoFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  toUser     User     @relation("KudoTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
  @@index([toUserId, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  storeId   String
  userId    String
  type      NotificationType
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime         @default(now())
  store     Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([storeId, createdAt])
}

model EmployeeNumberAlias {
  id             String   @id @default(cuid())
  employeeNumber String   @unique
  userId         String
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Kpi {
  id                   String    @id @default(cuid())
  userId               String
  storeId              String
  date                 DateTime
  dailySales           Decimal   @db.Decimal(12, 2)
  monthlySales         Decimal   @db.Decimal(12, 2)
  dailyGoal            Decimal   @db.Decimal(12, 2)
  monthlyGoal          Decimal   @db.Decimal(12, 2)
  avgTicket            Decimal   @db.Decimal(12, 2)
  upt                  Decimal   @db.Decimal(5, 2)
  conversion           Decimal?  @db.Decimal(5, 2)
  pieces               Int
  transactions         Int
  ranking              Int
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  discountMargin       Decimal?  @db.Decimal(5, 2)
  commissionAmount     Decimal   @default(0) @db.Decimal(12, 2)
  commissionPercent    Decimal   @default(0) @db.Decimal(5, 2)
  grossSales           Decimal?  @db.Decimal(12, 2)
  discountAmount       Decimal?  @db.Decimal(12, 2)
  discountLimit        Decimal?  @db.Decimal(5, 2)
  weekNumber           Int?
  weekStart            DateTime?
  weekEnd              DateTime?
  traffic              Int?
  commissionMinimum    Decimal?  @db.Decimal(12, 2)
  orkestraSales        Decimal?  @db.Decimal(12, 2)
  orkestraTransactions Int?
  orkestraPieces       Int?
  store                Store     @relation(fields: [storeId], references: [id])
  user                 User      @relation(fields: [userId], references: [id])

  @@unique([userId, date])
  @@index([storeId, date])
  @@index([storeId, weekStart, weekNumber])
}

model Schedule {
  id        String         @id @default(cuid())
  userId    String
  storeId   String
  day       String
  startTime String?
  endTime   String?
  zone      String?
  weekStart DateTime
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  date      DateTime
  status    ScheduleStatus @default(WORKING)
  statusRaw String?
  store     Store          @relation(fields: [storeId], references: [id])
  user      User           @relation(fields: [userId], references: [id])

  @@unique([userId, date])
  @@index([storeId, date])
}

model DayPlan {
  id          String        @id @default(cuid())
  userId      String
  storeId     String
  date        DateTime
  dailyGoal   Decimal       @db.Decimal(12, 2)
  focus       String
  message     String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  publishedAt DateTime?
  activities  DayPlanTask[]
  store       Store         @relation(fields: [storeId], references: [id])
  user        User          @relation(fields: [userId], references: [id])
}

model DayPlanTask {
  id          String     @id @default(cuid())
  planId      String
  title       String
  completed   Boolean    @default(false)
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  autoKey     String?
  plan        DayPlan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  comments    Comment[]
  evidences   Evidence[]

  @@map("Activity")
}

model ChoreAssignment {
  id        String   @id @default(cuid())
  storeId   String
  date      DateTime
  choreKey  String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, date, choreKey])
  @@index([storeId, choreKey])
}

model Pending {
  id          String          @id @default(cuid())
  storeId     String
  title       String
  description String
  category    PendingCategory
  priority    PendingPriority
  ownerId     String
  status      PendingStatus   @default(PENDIENTE)
  dueDate     DateTime
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  comments    Comment[]
  evidences   Evidence[]
  owner       User            @relation("PendingOwner", fields: [ownerId], references: [id])
  store       Store           @relation(fields: [storeId], references: [id])
}

model StoreLog {
  id          String     @id @default(cuid())
  storeId     String
  authorId    String
  category    String
  description String
  evidenceUrl String?
  createdAt   DateTime   @default(now())
  comments    Comment[]
  evidences   Evidence[]
  author      User       @relation(fields: [authorId], references: [id])
  store       Store      @relation(fields: [storeId], references: [id])
}

model Evidence {
  id           String       @id @default(cuid())
  storeId      String
  uploadedById String
  pendingId    String?
  logEntryId   String?
  taskId       String?
  url          String
  fileName     String?
  mimeType     String?
  note         String?
  createdAt    DateTime     @default(now())
  logEntry     StoreLog?    @relation(fields: [logEntryId], references: [id], onDelete: Cascade)
  pending      Pending?     @relation(fields: [pendingId], references: [id], onDelete: Cascade)
  store        Store        @relation(fields: [storeId], references: [id])
  task         DayPlanTask? @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy   User         @relation("EvidenceAuthor", fields: [uploadedById], references: [id])

  @@index([storeId, pendingId])
  @@index([storeId, taskId])
  @@index([storeId, logEntryId])
}

model Comment {
  id             String        @id @default(cuid())
  storeId        String
  authorId       String
  pendingId      String?
  taskId         String?
  logEntryId     String?
  body           String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  announcementId String?
  announcement   Announcement? @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  author         User          @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  logEntry       StoreLog?     @relation(fields: [logEntryId], references: [id], onDelete: Cascade)
  pending        Pending?      @relation(fields: [pendingId], references: [id], onDelete: Cascade)
  store          Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  task           DayPlanTask?  @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([storeId, pendingId, createdAt])
  @@index([storeId, taskId, createdAt])
  @@index([storeId, logEntryId, createdAt])
  @@index([storeId, announcementId, createdAt])
}

model CommissionRule {
  id                String   @id @default(cuid())
  storeId           String
  role              Role?
  minSales          Decimal  @default(0) @db.Decimal(12, 2)
  maxSales          Decimal? @db.Decimal(12, 2)
  commissionPercent Decimal  @default(0) @db.Decimal(5, 2)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  minAchievement    Decimal  @default(0) @db.Decimal(5, 2)
  maxAchievement    Decimal? @db.Decimal(5, 2)
  store             Store    @relation(fields: [storeId], references: [id])
}

model Announcement {
  id        String                 @id @default(cuid())
  storeId   String
  authorId  String
  title     String
  body      String
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  imageUrl  String?
  author    User                   @relation(fields: [authorId], references: [id])
  store     Store                  @relation(fields: [storeId], references: [id])
  reactions AnnouncementReaction[]
  reads     AnnouncementRead[]
  comments  Comment[]
}

model AnnouncementReaction {
  id             String       @id @default(cuid())
  announcementId String
  userId         String
  emoji          String
  createdAt      DateTime     @default(now())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId, emoji])
  @@index([announcementId])
}

model WebAuthnCredential {
  id           String   @id @default(cuid())
  userId       String
  credentialId String   @unique
  publicKey    String
  counter      BigInt   @default(0)
  transports   String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WebAuthnChallenge {
  id        String   @id @default(cuid())
  challenge String   @unique
  userId    String?
  expiresAt DateTime

  @@index([expiresAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AnnouncementRead {
  id             String       @id @default(cuid())
  announcementId String
  userId         String
  readAt         DateTime     @default(now())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id])

  @@unique([announcementId, userId])
}

model KpiTarget {
  id        String   @id @default(cuid())
  storeId   String
  metric    String
  value     Decimal  @db.Decimal(12, 2)
  period    String
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, metric, period])
  @@index([storeId])
}

model ChecklistEntry {
  id          String    @id @default(cuid())
  storeId     String
  date        String
  section     String
  itemKey     String
  completed   Boolean   @default(false)
  note        String?
  evidenceUrl String?
  completedBy String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, date, itemKey])
  @@index([storeId, date])
}

model DailyNotificationLog {
  id         String   @id @default(cuid())
  employeeId String
  date       String
  sent       Boolean  @default(true)
  case       String?
  createdAt  DateTime @default(now())
  type       String

  @@unique([employeeId, date, type])
  @@index([date])
}

// Dedup de alertas proactivas por tienda, usuario, periodo y tipo (p.ej. meta semanal 80%).
// Contador de rate limiting compartido entre instancias (fixed window). Sustituye
// al Map en memoria para que el límite funcione bajo PM2 cluster / multi-proceso.
model RateLimitCounter {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime

  @@index([resetAt])
}

model RetailAlertLog {
  id        String   @id @default(cuid())
  storeId   String
  userId    String
  periodKey String
  alertType String
  createdAt DateTime @default(now())
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId, periodKey, alertType])
  @@index([storeId, periodKey])
  @@index([userId])
}

model Survey {
  id          String           @id @default(cuid())
  storeId     String
  authorId    String
  title       String
  description String?
  anonymous   Boolean          @default(true)
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  author      User             @relation("SurveyAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  store       Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  questions   SurveyQuestion[]
  responses   SurveyResponse[]

  @@index([storeId, createdAt])
}

model SurveyQuestion {
  id       String         @id @default(cuid())
  surveyId String
  text     String
  type     String         @default("RATING")
  order    Int            @default(0)
  answers  SurveyAnswer[]
  survey   Survey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@index([surveyId])
}

model SurveyResponse {
  id        String         @id @default(cuid())
  surveyId  String
  userId    String
  createdAt DateTime       @default(now())
  answers   SurveyAnswer[]
  survey    Survey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  user      User           @relation("SurveyRespondent", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([surveyId, userId])
  @@index([surveyId])
}

model SurveyAnswer {
  id         String         @id @default(cuid())
  responseId String
  questionId String
  rating     Int?
  text       String?
  question   SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  response   SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@index([responseId])
  @@index([questionId])
}

model ChatRoom {
  id        String        @id @default(cuid())
  storeId   String
  type      ChatRoomType  @default(DIRECT)
  name      String?
  createdAt DateTime      @default(now())
  members   ChatMember[]
  messages  ChatMessage[]
  store     Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

model ChatMember {
  id       String   @id @default(cuid())
  roomId   String
  userId   String
  joinedAt DateTime @default(now())
  room     ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId])
}

model ChatMessage {
  id          String                @id @default(cuid())
  roomId      String
  senderId    String
  body        String
  createdAt   DateTime              @default(now())
  deletedAt   DateTime?
  replyToId   String?
  replyTo     ChatMessage?          @relation("ChatReply", fields: [replyToId], references: [id])
  replies     ChatMessage[]         @relation("ChatReply")
  room        ChatRoom              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender      User                  @relation(fields: [senderId], references: [id], onDelete: Cascade)
  deliveredTo ChatMessageDelivery[]
  hiddenFor   ChatMessageHide[]
  reactions   ChatMessageReaction[]
  readBy      ChatMessageRead[]

  @@index([roomId, createdAt])
  @@index([replyToId])
}

model ChatMessageRead {
  id        String      @id @default(cuid())
  messageId String
  userId    String
  readAt    DateTime    @default(now())
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
}

model ChatMessageDelivery {
  id          String      @id @default(cuid())
  messageId   String
  userId      String
  deliveredAt DateTime    @default(now())
  message     ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
}

model ChatMessageHide {
  id        String      @id @default(cuid())
  messageId String
  userId    String
  hiddenAt  DateTime    @default(now())
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
}

model MatchEvent {
  id           String   @id @default(cuid())
  opponent     String
  opponentFlag String?
  competition  String?
  kickoff      DateTime
  mxScore      Int      @default(0)
  rivalScore   Int      @default(0)
  status       String   @default("SCHEDULED")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  externalId   Int?
  streamUrl    String?
  homeTeam     String?
  homeFlag     String?

  @@index([kickoff])
  @@index([status])
}

model CycleCountTag {
  id        String            @id @default(cuid())
  storeId   String
  number    Int
  zone      CycleCountZone
  label     String?
  active    Boolean           @default(true)
  createdAt DateTime          @default(now())
  entries   CycleCountEntry[]
  store     Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, number])
  @@index([storeId, zone])
}

model CycleCount {
  id          String            @id @default(cuid())
  storeId     String
  date        DateTime
  status      String            @default("OPEN")
  theoretical Int?
  notes       String?
  createdAt   DateTime          @default(now())
  closedAt    DateTime?
  store       Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  entries     CycleCountEntry[]
  noUpcItems  CycleCountNoUpc[]

  @@index([storeId, date])
}

model CycleCountEntry {
  id           String        @id @default(cuid())
  countId      String
  tagId        String
  count1       Int?
  count1ById   String?
  count1ByName String?
  count1At     DateTime?
  count2       Int?
  count2ById   String?
  count2ByName String?
  count2At     DateTime?
  count3       Int?
  count3ById   String?
  count3ByName String?
  count3At     DateTime?
  count        CycleCount    @relation(fields: [countId], references: [id], onDelete: Cascade)
  tag          CycleCountTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([countId, tagId])
  @@index([countId])
}

model CycleCountNoUpc {
  id      String     @id @default(cuid())
  countId String
  concept String
  pieces  Int
  count   CycleCount @relation(fields: [countId], references: [id], onDelete: Cascade)

  @@index([countId])
}

model SubscriptionPayment {
  id          String   @id @default(cuid())
  storeId     String
  mpPaymentId String   @unique
  amountMxn   Decimal  @db.Decimal(10, 2)
  status      String
  method      String?
  paidAt      DateTime @default(now())
  periodEnd   DateTime
  createdAt   DateTime @default(now())
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, paidAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  storeId   String?
  storeName String?
  actorId   String?
  actorName String
  action    String
  entity    String
  entityId  String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([storeId, createdAt])
}

model ChatMessageReaction {
  id        String      @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime    @default(now())
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
}

