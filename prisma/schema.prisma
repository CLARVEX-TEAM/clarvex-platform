model AiMemory {
  id        String   @id @default(cuid())
  storeId   String
  userId    String?
  key       String   // e.g., "advisor_profile", "last_activities", "weekly_context"
  content   String   // JSON string containing stored memory/data
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId, key])
  @@index([storeId, key])
}

model AiPlanHistory {
  id             String   @id @default(cuid())
  storeId        String
  userId         String
  date           DateTime
  kpisUsed       String   // JSON snapshot of KPIs at that moment
  focus          String
  message        String
  activities     String[] // Specific activities generated
  outcomeSales   Decimal? @db.Decimal(12, 2)
  outcomeGoal    Decimal? @db.Decimal(12, 2)
  outcomeSuccess Boolean?
  createdAt      DateTime @default(now())
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([storeId, userId, date])
}

model AiRecommendationHistory {
  id             String   @id @default(cuid())
  storeId        String
  userId         String?
  type           String   // e.g., "KPI_ALERT", "TASK_SUGGESTION", "COACHING"
  recommendation String   // Text/JSON of recommendation
  outcomeSuccess Boolean?
  createdAt      DateTime @default(now())
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([storeId, userId])
}

model AiDailySummary {
  id              String    @id @default(cuid())
  storeId         String
  summaryDate     DateTime  @db.Date
  type            String    @default("STORE_DAILY")
  scopeKey        String    @default("STORE")
  status          String    @default("PENDING")
  content         Json?
  metricsSnapshot Json?
  sourceDataHash  String?
  errorMessage    String?
  generatedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, summaryDate, type, scopeKey])
  @@index([storeId, summaryDate])
}

// Consumo de IA por petición del Copilot. Sin relaciones a Store/User a
// propósito: es una bitácora desacoplada (append-only) para costos, cuotas y
// observabilidad; nunca debe bloquear ni acoplar la operación principal.
model AiUsageLog {
  id               String   @id @default(cuid())
  storeId          String
  userId           String?
  feature          String   // p.ej. "copilot"
  provider         String   // p.ej. "groq", "cloudflare", "mock"
  model            String
  modelTier        String   // "fast" | "advanced"
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  toolCalls        Int      @default(0)
  iterations       Int      @default(0)
  latencyMs        Int      @default(0)
  status           String   // "success" | "error"
  errorMessage     String?
  createdAt        DateTime @default(now())

  @@index([storeId, createdAt])
  @@index([userId, createdAt])
}
