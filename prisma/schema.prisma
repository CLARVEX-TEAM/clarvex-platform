generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  GERENTE
  SUBGERENTE
  ASESOR
}

enum PendingCategory {
  OPERACION
  EQUIPO
  COMERCIAL
  CLIENTE
  INVENTARIO
  MANTENIMIENTO
}

enum PendingPriority {
  BAJA
  MEDIA
  ALTA
  CRITICA
}

enum PendingStatus {
  PENDIENTE
  EN_PROCESO
  COMPLETADO
}

enum DataSourceType {
  HORARIOS
  KPIS
  METAS
  COMISIONES
  COMUNICADOS
  DESCUENTOS_POS
}

enum DataSourceProvider {
  MANUAL
  EXCEL
  SHAREPOINT
}

enum DataSourceStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

enum DataSourceFrequency {
  MANUAL
  HOURLY
  DAILY
  WEEKLY
}

enum SyncLogStatus {
  SUCCESS
  ERROR
  RUNNING
}

enum ScheduleStatus {
  WORKING
  OFF
  VACATION
  PAID_DAY
  INVENTORY
  TERMINATED
}

model Store {
  id             String         @id @default(cuid())
  name           String
  users          User[]
  kpis           Kpi[]
  schedules      Schedule[]
  plans          DayPlan[]
  pendings       Pending[]
  logEntries     StoreLog[]
  announcements  Announcement[]
  evidences      Evidence[]
  commissionRules CommissionRule[]
  dataSources     DataSource[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model DataSource {
  id         String             @id @default(cuid())
  storeId    String
  store      Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  type       DataSourceType
  provider   DataSourceProvider @default(MANUAL)
  name       String
  url        String?
  status     DataSourceStatus   @default(DISCONNECTED)
  frequency  DataSourceFrequency @default(MANUAL)
  lastSyncAt DateTime?
  nextSyncAt DateTime?
  syncLogs   SyncLog[]
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@unique([storeId, type])
  @@index([storeId, status])
}

model SyncLog {
  id               String        @id @default(cuid())
  dataSourceId     String
  dataSource       DataSource    @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)
  status           SyncLogStatus
  message          String
  recordsProcessed Int           @default(0)
  createdAt        DateTime      @default(now())

  @@index([dataSourceId, createdAt])
}

model User {
  id                    String                 @id @default(cuid())
  name                  String
  email                 String                 @unique
  employeeNumber        String                 @unique
  passwordHash          String
  pinHash               String?
  photoUrl              String?
  biometricEnabled      Boolean                @default(false)
  lastLoginAt           DateTime?
  role                  Role
  storeId               String
  store                 Store                  @relation(fields: [storeId], references: [id])
  kpis                  Kpi[]
  schedules             Schedule[]
  plans                 DayPlan[]
  assignedPendings      Pending[]              @relation("PendingOwner")
  authoredLogs          StoreLog[]
  evidences             Evidence[]             @relation("EvidenceAuthor")
  authoredAnnouncements Announcement[]
  announcementReads     AnnouncementRead[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
}

model Kpi {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  storeId        String
  store          Store    @relation(fields: [storeId], references: [id])
  date           DateTime
  dailySales     Decimal  @db.Decimal(12, 2)
  monthlySales   Decimal  @db.Decimal(12, 2)
  dailyGoal      Decimal  @db.Decimal(12, 2)
  monthlyGoal    Decimal  @db.Decimal(12, 2)
  avgTicket      Decimal  @db.Decimal(12, 2)
  upt            Decimal  @db.Decimal(5, 2)
  conversion     Decimal  @db.Decimal(5, 2)
  pieces         Int
  transactions   Int
  ranking        Int
  grossSales     Decimal? @db.Decimal(12, 2)
  discountAmount Decimal? @db.Decimal(12, 2)
  discountMargin Decimal? @db.Decimal(5, 2)
  discountLimit  Decimal? @db.Decimal(5, 2)
  commissionAmount Decimal @default(0) @db.Decimal(12, 2)
  commissionPercent Decimal @default(0) @db.Decimal(5, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, date])
  @@index([storeId, date])
}

model Schedule {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id])
  storeId   String
  store     Store          @relation(fields: [storeId], references: [id])
  date      DateTime
  day       String
  status    ScheduleStatus @default(WORKING)
  statusRaw String?
  startTime String?
  endTime   String?
  zone      String?
  weekStart DateTime
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([userId, date])
  @@index([storeId, date])
}

model DayPlan {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id])
  storeId   String
  store     Store      @relation(fields: [storeId], references: [id])
  date      DateTime
  dailyGoal Decimal    @db.Decimal(12, 2)
  focus     String
  message   String
  activities DayPlanTask[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model DayPlanTask {
  id          String   @id @default(cuid())
  planId      String
  plan        DayPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  title       String
  completed   Boolean  @default(false)
  completedAt DateTime?
  evidences   Evidence[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("Activity")
}

model Pending {
  id          String          @id @default(cuid())
  storeId     String
  store       Store           @relation(fields: [storeId], references: [id])
  title       String
  description String
  category    PendingCategory
  priority    PendingPriority
  ownerId     String
  owner       User            @relation("PendingOwner", fields: [ownerId], references: [id])
  status      PendingStatus   @default(PENDIENTE)
  dueDate     DateTime
  evidences   Evidence[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model StoreLog {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id])
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  category    String
  description String
  evidenceUrl String?
  evidences   Evidence[]
  createdAt   DateTime @default(now())
}

model Evidence {
  id           String       @id @default(cuid())
  storeId      String
  store        Store        @relation(fields: [storeId], references: [id])
  uploadedById String
  uploadedBy   User         @relation("EvidenceAuthor", fields: [uploadedById], references: [id])
  pendingId    String?
  pending      Pending?     @relation(fields: [pendingId], references: [id], onDelete: Cascade)
  logEntryId   String?
  logEntry     StoreLog?    @relation(fields: [logEntryId], references: [id], onDelete: Cascade)
  taskId       String?
  task         DayPlanTask? @relation(fields: [taskId], references: [id], onDelete: Cascade)
  url          String
  fileName     String?
  mimeType     String?
  note         String?
  createdAt    DateTime     @default(now())
}

model CommissionRule {
  id                String   @id @default(cuid())
  storeId           String
  store             Store    @relation(fields: [storeId], references: [id])
  role              Role?
  minSales          Decimal  @default(0) @db.Decimal(12, 2)
  maxSales          Decimal? @db.Decimal(12, 2)
  minAchievement    Decimal  @default(0) @db.Decimal(5, 2)
  maxAchievement    Decimal? @db.Decimal(5, 2)
  commissionPercent Decimal  @default(0) @db.Decimal(5, 2)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Announcement {
  id        String             @id @default(cuid())
  storeId   String
  store     Store              @relation(fields: [storeId], references: [id])
  authorId  String
  author    User               @relation(fields: [authorId], references: [id])
  title     String
  body      String
  reads     AnnouncementRead[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model AnnouncementRead {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  readAt         DateTime     @default(now())

  @@unique([announcementId, userId])
}
