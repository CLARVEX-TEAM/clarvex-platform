  value     Decimal  @db.Decimal(12, 2)
  period    String
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, metric, period])
  @@index([storeId])
}

model ChecklistEntry {
  id          String    @id @default(cuid())
  storeId     String
  date        String
  section     String
  itemKey     String
  completed   Boolean   @default(false)
  note        String?
  evidenceUrl String?
  completedBy String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, date, itemKey])
  @@index([storeId, date])
}

/// Definición de los puntos del checklist, EDITABLE por tienda (gerencia agrega,
/// renombra, reordena y quita). `key` es el identificador estable que referencian
/// ChecklistEntry y ChecklistScan; se conserva aunque cambie la etiqueta. Quitar
/// un punto lo marca active=false (no se borra, para no perder el histórico).
model ChecklistItem {
  id        String   @id @default(cuid())
  storeId   String
  key       String
  section   String
  kind      String   @default("check")
  label     String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, key])
  @@index([storeId])
}

/// Fotos de los ítems de ESCANEO del checklist (corte de caja, vouchers, depósito).
/// Van varias por documento, a diferencia de la foto única de ChecklistEntry.
/// Cada una se manda al canal de Telegram al subirse.
model ChecklistScan {
  id           String   @id @default(cuid())
  storeId      String
  date         String
  itemKey      String
  url          String
  fileName     String?
  uploadedById String
  createdAt    DateTime @default(now())
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, date, itemKey])
}

/// Una escritura que ya se hizo, para que un reintento no la repita.
///
/// ⚠️ **Es el cimiento de la captura sin conexión.** Una cola que reintenta sin
/// esto duplica: la evidencia del checklist crea un objeto nuevo en R2 y una
/// fila más en cada intento, y un folio de traspaso capturado dos veces suma sus
/// piezas dos veces al teórico. El 14 de septiembre de 2026 pasó de verdad con
/// el folio 1766932, sin cola de por medio.
///
/// El cliente manda una clave por operación; el servidor la reserva ANTES de
/// escribir y guarda la respuesta al terminar. Un segundo intento con la misma
/// clave recibe la respuesta original en vez de volver a escribir.
model IdempotentWrite {
  id        String   @id @default(cuid())
  /// La clave que manda el cliente. Única DENTRO de la tienda: una tienda no
  /// puede pisar ni leer la operación de otra adivinando una clave.
  key       String
  storeId   String
  userId    String
  /// Qué endpoint la atendió. Solo para leer el historial; no forma la clave.
  route     String
  /// Huella del cuerpo. La MISMA clave con OTRO cuerpo es un fallo del cliente
  /// y se rechaza en alto: devolver la respuesta vieja se tragaría una
  /// escritura real sin que nadie se entere.
  bodyHash  String
  /// `null` mientras la operación está en curso. Una clave reservada y sin
  /// respuesta significa «se está escribiendo, o se cayó a medias»: ahí se
  /// rechaza el reintento en vez de arriesgar un duplicado.
  status    Int?
  response  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, key])
  @@index([createdAt])
}

model DailyNotificationLog {
  id         String   @id @default(cuid())
  employeeId String
  date       String
  sent       Boolean  @default(true)
  case       String?
  createdAt  DateTime @default(now())
  type       String

  @@unique([employeeId, date, type])
  @@index([date])
}

// Dedup de alertas proactivas por tienda, usuario, periodo y tipo (p.ej. meta semanal 80%).
// Contador de rate limiting compartido entre instancias (fixed window). Sustituye
// al Map en memoria para que el límite funcione bajo PM2 cluster / multi-proceso.
model RateLimitCounter {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime

  @@index([resetAt])
}

model RetailAlertLog {
  id        String   @id @default(cuid())
  storeId   String
  userId    String
  periodKey String
  alertType String
  createdAt DateTime @default(now())
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId, periodKey, alertType])
  @@index([storeId, periodKey])
  @@index([userId])
}

// Entregas de asistencia confirmadas por gerencia. Los cierres de Blitz usan
// "MES-2026-08-01" / "QUINCENA-2026-07-15"; el Forms diario de AXO usa
// "AXO-DIARIO-2026-09-16". Existir la fila = "ya lo envié" para ese periodo.
model ReportDelivery {
  id            String   @id @default(cuid())
  storeId       String
  kind          String
  periodKey     String
  dueDate       String
  confirmedById String
  createdAt     DateTime @default(now())
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  confirmedBy   User     @relation(fields: [confirmedById], references: [id], onDelete: Cascade)

  @@unique([storeId, periodKey])
  @@index([storeId, createdAt])
}

model Survey {
  id          String           @id @default(cuid())
  storeId     String
  authorId    String
  title       String
  description String?
  anonymous   Boolean          @default(true)
  /// A quien va dirigida: "ALL" (todo el equipo) o "ADVISORS" (solo asesores).
  /// Por omision ALL, que es como se comportaban las encuestas ya existentes.
  audience    String           @default("ALL")
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  author      User             @relation("SurveyAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  store       Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  questions   SurveyQuestion[]
  responses   SurveyResponse[]

  @@index([storeId, createdAt])
}

model SurveyQuestion {
  id       String         @id @default(cuid())
  surveyId String
  text     String
  type     String         @default("RATING")
  order    Int            @default(0)
  answers  SurveyAnswer[]
  survey   Survey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@index([surveyId])
}

model SurveyResponse {
  id        String         @id @default(cuid())
  surveyId  String
  userId    String
  createdAt DateTime       @default(now())
  answers   SurveyAnswer[]
  survey    Survey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  user      User           @relation("SurveyRespondent", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([surveyId, userId])
  @@index([surveyId])
}

model SurveyAnswer {
  id         String         @id @default(cuid())
  responseId String
  questionId String
  rating     Int?
  text       String?
  question   SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  response   SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@index([responseId])
  @@index([questionId])
}

model ChatRoom {
  id        String        @id @default(cuid())
  storeId   String
  type      ChatRoomType  @default(DIRECT)
  name      String?
  createdAt DateTime      @default(now())
  members   ChatMember[]
  messages  ChatMessage[]
  store     Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

model ChatMember {
  id       String    @id @default(cuid())
  roomId   String
  userId   String
  joinedAt DateTime  @default(now())
  /// Ultima vez que esta persona estaba escribiendo en esta sala.
  ///
  /// Vive aqui y no en una tabla propia porque la fila ya existe: una tabla
  /// nueva para un dato que caduca en seis segundos es mantenimiento sin
  /// contrapartida. Se escribe como mucho una vez cada 3 s por persona, no en
  /// cada tecla.
  typingAt DateTime?
  room     ChatRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId])
}

model ChatMessage {
  id          String                @id @default(cuid())
  roomId      String
  senderId    String
  body        String
  createdAt   DateTime              @default(now())
  deletedAt   DateTime?
  /// Cuando se corrigio. La pantalla marca «editado»: cambiar lo dicho sin
  /// que se note es peor que no poder corregir.
  editedAt    DateTime?
  /// Fijado arriba de la sala. Se guarda QUIEN lo fijo para poder preguntarle.
  pinnedAt    DateTime?
  pinnedById  String?
  replyToId   String?
  replyTo     ChatMessage?          @relation("ChatReply", fields: [replyToId], references: [id])
  replies     ChatMessage[]         @relation("ChatReply")
  room        ChatRoom              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender      User                  @relation(fields: [senderId], references: [id], onDelete: Cascade)
  deliveredTo ChatMessageDelivery[]
  hiddenFor   ChatMessageHide[]
  reactions   ChatMessageReaction[]
  readBy      ChatMessageRead[]

  /// A quien se menciono con @. Vacio si no se menciono a nadie.
  mentions ChatMention[]

  @@index([roomId, createdAt])
  @@index([replyToId])
