# Base de datos PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/clarvex_team?schema=public"

# Autenticacion JWT (genera con: openssl rand -base64 32)
AUTH_SECRET="cambia-este-secreto-minimo-32-caracteres"

# Cloudflare Worker proxy para Excel
EXCEL_PROXY_WORKER_URL="https://clarvexteam.jhernandezl2c.workers.dev"

# Cloudflare R2 — almacenamiento de fotos y evidencias
R2_ACCOUNT_ID="tu-account-id-de-cloudflare"
R2_ACCESS_KEY_ID="tu-r2-access-key-id"
R2_SECRET_ACCESS_KEY="tu-r2-secret-access-key"
R2_BUCKET_NAME="clarvex-uploads"
R2_PUBLIC_URL="https://pub-xxxxxxxxxxxxxxxx.r2.dev"

# Web Push — notificaciones sin app abierta
# Generadas una vez con: node -e "const wp=require('web-push');console.log(wp.generateVAPIDKeys())"
VAPID_PUBLIC_KEY="tu-vapid-public-key-generada"
VAPID_PRIVATE_KEY="tu-vapid-private-key-generada"

# Cron — protege POST /api/cron/daily-summary (genera con: openssl rand -hex 32)
CRON_SECRET="cambia-este-secreto-del-cron"

# Sincronizacion desde el panel de administracion externo (Retool).
# Secreto PROPIO, distinto de CRON_SECRET: este vive en una herramienta de
# terceros y solo debe servir para sincronizar una fuente, no para abrir todas
# las rutas /api/cron/*. Minimo 32 caracteres; sin el, la ruta responde 401.
ADMIN_SYNC_SECRET="cambia-este-secreto-minimo-32-caracteres"

# Captura manual de datos operativos desde el panel externo (Retool), la via que
# sustituye a los Excel de SharePoint. Secreto PROPIO, distinto de
# ADMIN_SYNC_SECRET: aquel solo dispara la relectura de un archivo ya
# configurado, y este ESCRIBE horarios (y despues ventas y asistencia).
# Minimo 32 caracteres; sin el, la ruta responde 401.
ADMIN_CAPTURE_SECRET="cambia-este-secreto-minimo-32-caracteres"

# Klipy GIF Search — opcional, habilita la pestaña GIF en el chat
# Tenor cerró registros (apaga su API el 30-jun-2026); Klipy es el reemplazo.
# Obtén tu clave gratis en: https://klipy.com/developers
KLIPY_API_KEY=""

# CLARVEX Copilot (IA) — proveedor principal: Groq (API compatible con OpenAI).
# Obtén tu clave en: https://console.groq.com/keys
GROQ_API_KEY=""
# Opcionales (tienen valores por defecto sensatos):
# AI_PROVIDER="groq"
# AI_FALLBACK_PROVIDERS="cloudflare"
# AI_MODEL_FAST="openai/gpt-oss-20b"
# AI_MODEL_ADVANCED="openai/gpt-oss-120b"
# AI_COPILOT_PHASE="1"            # 1=solo lectura, 2=borradores, 3=acciones
# AI_MAX_TOOL_ITERATIONS="5"
# AI_REQUEST_TIMEOUT_MS="30000"

# Respaldo futuro: Cloudflare Workers AI (endpoint compatible con OpenAI)
# CLOUDFLARE_ACCOUNT_ID=""
# CLOUDFLARE_AI_TOKEN=""

# Backups — bucket R2 AISLADO para los respaldos de la base de datos.
# Muy recomendado: si los backups comparten bucket y credenciales con la app, la
# misma llave que sube las fotos puede BORRAR los respaldos. Un VPS comprometido
# destruiría datos y copias de seguridad de un tirón.
# Crea un bucket aparte y un token de R2 acotado SOLO a ese bucket.
# Si se dejan vacías, se usan las credenciales de la app (el script lo advierte).
BACKUP_R2_BUCKET_NAME=""
BACKUP_R2_ACCESS_KEY_ID=""
BACKUP_R2_SECRET_ACCESS_KEY=""
# BACKUP_R2_ACCOUNT_ID=""      # solo si el bucket vive en otra cuenta de Cloudflare
# BACKUP_RETENTION_DAYS="30"

# Sentry — monitoreo de errores en producción. Opcional: si el DSN está vacío,
# Sentry queda completamente desactivado (no-op) y el build no cambia.
# Obtén el DSN en: https://sentry.io → Settings → Projects → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=""
# Solo para subir source maps (stack traces legibles en vez de minificados).
# Sin el token el build igual funciona; los stack traces salen minificados.
# SENTRY_ORG=""
# SENTRY_PROJECT=""
# SENTRY_AUTH_TOKEN=""

# Webhook de fotos → n8n → canal de Telegram. Opcional: sin WEBHOOK_URL no se
# manda nada y la app funciona igual.
#
# ⚠️ Manda las fotos FUERA de tu infraestructura. R2 es privado; Telegram no.
# Quien esté en el canal ve todas las evidencias y faltantes de esa tienda.
#
# WEBHOOK_STORE_IDS es obligatorio para que se active: sin la lista no se manda
# nada. Es a propósito — la app es multi-tienda y las fotos de una tienda no
# pueden acabar en el canal de otra por descuido. Separa varias con comas.
WEBHOOK_URL=""
WEBHOOK_STORE_IDS=""
# Se manda como header X-Clarvex-Secret para que n8n rechace POSTs de fuera.
WEBHOOK_SECRET=""

# Soporte con Zendesk. Opcional: sin estas 3 variables, la pantalla de Soporte
# avisa que aún no está configurado (no se rompe nada). El ticket se crea vía la
# API REST de Zendesk desde el servidor (sin scripts externos → respeta el CSP).
# El API token se genera en Zendesk: Admin Center → Apps e integraciones → API
# de Zendesk → Tokens de API.
ZENDESK_SUBDOMAIN=""
ZENDESK_EMAIL=""
ZENDESK_API_TOKEN=""

# Retool embebido — captura de horarios y asistencia dentro de Clarvex.
# Los gerentes NO necesitan cuenta de Retool: entran con su PIN de siempre y la
# pantalla se incrusta como "usuario externo" (gratis hasta 50 personas).
# El token se crea en Retool: Settings > API. El group id sale de la URL del
# grupo en Settings > Groups.
RETOOL_API_TOKEN=
RETOOL_ORG_URL="https://clarvex.retool.com"
RETOOL_APP_UUID="b6ebeac8-95fd-11f1-a579-b33e5e6ede64"
RETOOL_EMBED_GROUP_ID=

# Comunicados → WhatsApp (Evolution API → grupo de la tienda). Opcional: sin
# estas variables el comunicado se publica igual y no se manda nada a WhatsApp.
#
# WHATSAPP_EVOLUTION_URL: base de la Evolution API, p. ej. https://wa.clarvex.tech
# WHATSAPP_EVOLUTION_INSTANCE: nombre de la instancia (p. ej. "tienda")
# WHATSAPP_EVOLUTION_API_KEY: la AUTHENTICATION_API_KEY de la instancia.
# WHATSAPP_ANNOUNCE_GROUP_JID: JID del grupo destino (termina en @g.us).
#
# ⚠️ WHATSAPP_ANNOUNCE_STORE_IDS es obligatorio para que se active: CSV de ids de
# tienda cuyos comunicados van a WhatsApp. Sin la lista no se manda nada — la app
# es multi-tienda y un comunicado de una tienda no puede acabar en el grupo de
# otra por descuido.
WHATSAPP_EVOLUTION_URL=""
WHATSAPP_EVOLUTION_INSTANCE=""
WHATSAPP_EVOLUTION_API_KEY=""
WHATSAPP_ANNOUNCE_GROUP_JID=""
WHATSAPP_ANNOUNCE_STORE_IDS=""
