# Base de datos PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/clarvex_team?schema=public"

# Autenticacion JWT (genera con: openssl rand -base64 32)
AUTH_SECRET="cambia-este-secreto-minimo-32-caracteres"

# Cloudflare Worker proxy para Excel
EXCEL_PROXY_WORKER_URL="https://clarvexteam.jhernandezl2c.workers.dev"

# Cloudflare R2 — almacenamiento de fotos y evidencias
R2_ACCOUNT_ID="tu-account-id-de-cloudflare"
R2_ACCESS_KEY_ID="tu-r2-access-key-id"
R2_SECRET_ACCESS_KEY="tu-r2-secret-access-key"
R2_BUCKET_NAME="clarvex-uploads"
R2_PUBLIC_URL="https://pub-xxxxxxxxxxxxxxxx.r2.dev"

# Web Push — notificaciones sin app abierta
# Generadas una vez con: node -e "const wp=require('web-push');console.log(wp.generateVAPIDKeys())"
VAPID_PUBLIC_KEY="tu-vapid-public-key-generada"
VAPID_PRIVATE_KEY="tu-vapid-private-key-generada"

# Cron — protege POST /api/cron/daily-summary (genera con: openssl rand -hex 32)
CRON_SECRET="cambia-este-secreto-del-cron"

# Klipy GIF Search — opcional, habilita la pestaña GIF en el chat
# Tenor cerró registros (apaga su API el 30-jun-2026); Klipy es el reemplazo.
# Obtén tu clave gratis en: https://klipy.com/developers
KLIPY_API_KEY=""

# CLARVEX Copilot (IA) — proveedor principal: Groq (API compatible con OpenAI).
# Obtén tu clave en: https://console.groq.com/keys
GROQ_API_KEY=""
# Opcionales (tienen valores por defecto sensatos):
# AI_PROVIDER="groq"
# AI_FALLBACK_PROVIDERS="cloudflare"
# AI_MODEL_FAST="openai/gpt-oss-20b"
# AI_MODEL_ADVANCED="openai/gpt-oss-120b"
# AI_COPILOT_PHASE="1"            # 1=solo lectura, 2=borradores, 3=acciones
# AI_MAX_TOOL_ITERATIONS="5"
# AI_REQUEST_TIMEOUT_MS="30000"

# Respaldo futuro: Cloudflare Workers AI (endpoint compatible con OpenAI)
# CLOUDFLARE_ACCOUNT_ID=""
# CLOUDFLARE_AI_TOKEN=""
