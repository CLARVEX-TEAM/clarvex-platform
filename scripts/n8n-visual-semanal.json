      {
        "parameters": {
          "jsCode": "// El pie de foto ES el nombre del hueco. No hace falta escribir \"visual\"\n// delante --se acepta por costumbre, pero sobra--: lo natural es poner\n// \"WSW ZONA 2\" y eso es lo que hay que entender.\n//\n// ⚠️ Y SIN pie tambien vale: se guarda con un nombre provisional y luego\n// «visual reconocer» averigua su zona comparandola con la semana pasada.\n// Rechazarla obligaba a teclear trece pies cada jueves.\nconst mensaje = $('Mensaje').first().json.message;\nconst pie = (mensaje.caption || '').trim();\nconst huecos = ($json.huecos || []).map((h) => h.etiqueta);\n\nconst plano = (s) => String(s).normalize('NFD').replace(/[\\u0300-\\u036f]/g, '')\n  .replace(/[_-]+/g, ' ').replace(/\\s+/g, ' ').trim().toLowerCase();\n\nconst limpiar = (s) => {\n  const PERMITIDOS = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789 ';\n  let out = '';\n  for (const c of s) out += PERMITIDOS.indexOf(c) >= 0 ? c : ' ';\n  return out.replace(/\\s+/g, ' ').trim();\n};\n\nconst buscado = plano(pie.replace(/^visual\\s+/i, ''));\n\nif (!buscado) {\n  // El id del mensaje evita que dos fotos del mismo album se pisen: en un\n  // album Telegram las manda casi a la vez y el nombre seria el mismo.\n  return [{ json: { valido: true, sinNombre: true, etiqueta: null, archivo: 'sin-nombre-' + mensaje.message_id + '.jpg' } }];\n}\n\nconst casa = huecos.find((h) => plano(h) === buscado);\nif (!casa) {\n  // ⚠️ Un pie que NO casa con ningun hueco si se rechaza. Guardarlo como\n  // «sin nombre» seria tragarse una errata y acabar colocandola en otro\n  // sitio: lo escribio a proposito, asi que hay que decir que no cuadra.\n  return [{ json: { valido: false, respuesta: 'No reconozco \"' + pie + '\".\\n\\nLos espacios son:\\n' + huecos.map((h) => '  ' + h).join('\\n') + '\\n\\nO mandala sin pie y luego \"visual reconocer\".' } }];\n}\n\n// El archivo se llama como el hueco, no como lo escribio: asi el servidor\n// lo empareja sin volver a normalizar nada.\nreturn [{ json: { valido: true, sinNombre: false, etiqueta: casa, archivo: limpiar(casa) + '.jpg' } }];"
        },
