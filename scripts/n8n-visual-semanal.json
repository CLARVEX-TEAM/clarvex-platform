        "id": "v0000000-0033-4000-8000-000000000033",
        "name": "Leer el traspaso",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "onError": "continueErrorOutput",
        "position": [
          40,
          760
        ]
      },
      {
        "parameters": {
          "jsCode": "// El servidor contesta 201 con el traspaso YA GUARDADO, o 4xx con el motivo en\n// claro. Ese motivo es lo unico util de la respuesta: dice si las dos lecturas\n// no coincidieron, o que numero no cuadra.\nconst r = $json;\nconst cuerpo = r.body || {};\n\nif (r.statusCode !== 201) {\n  const lineas = [cuerpo.error || 'No se pudo leer la hoja.'];\n  for (const d of (cuerpo.detalle || [])) lineas.push('- ' + d);\n  lineas.push('', 'No se guardo nada. Manda otra foto, mas derecha y con el encabezado completo.');\n  return [{ json: { respuesta: lineas.join('\\n') } }];\n}\n\nconst sentido = cuerpo.direccion === 'SALIDA' ? 'Salida a' : 'Entrada de';\nconst lineas = [\n  'Traspaso guardado en el kardex.',\n  '',\n  'Folio ' + cuerpo.folio,\n  sentido + ' ' + cuerpo.contraparte,\n  cuerpo.piezas + ' piezas',\n  'Fechado hoy: ' + cuerpo.fecha\n];\n\n/*\n * ⚠️ Se dice CUANTO se pudo comprobar, y no se calla ninguno de los tres casos.\n *\n * La hoja no trae una cuenta que cierre --solo llega la primera pagina y sus\n * renglones no suman el total-- asi que la comprobacion real es que dos modelos\n * distintos hayan leido lo mismo. Si alguna comprobacion no corrio, quien\n * captura tiene que saberlo para mirar el papel: callarlo dejaria «se\n * comprobo» y «no se pudo» indistinguibles.\n */\n/*\n * ⚠️ La hoja se fecha el dia de la CAPTURA, no con la fecha impresa: esa es la\n * de impresion y el campo «Fecha en que se despacho» viene en blanco. Se enseña\n * la del papel solo cuando NO coincide, como referencia para buscarlo.\n */\nconst avisos = [];\nif (cuerpo.fechaImpresaEnLaHoja && cuerpo.fechaImpresaEnLaHoja !== cuerpo.fecha) {\n  avisos.push('La hoja se imprimio el ' + cuerpo.fechaImpresaEnLaHoja + '.');\n}\nif (!cuerpo.confirmadaPorDos) avisos.push('La segunda lectura no respondio, asi que las piezas se leyeron UNA sola vez: comprueba el total contra la hoja.');\nif (!cuerpo.comprobadaLaTienda) avisos.push('No se pudo comprobar que la hoja sea de tu tienda.');\nif (cuerpo.cuadraLaPagina) avisos.push('Los renglones de la hoja suman el total, asi que el numero esta doblemente confirmado.');\nif (avisos.length > 0) lineas.push('', ...avisos);\n\nreturn [{ json: { respuesta: lineas.join('\\n') } }];"
        },
