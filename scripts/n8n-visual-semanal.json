      {
        "parameters": {
          "jsCode": "// La captura viaja en base64 dentro del JSON, igual que la del reporte del POS.\n//\n// ⚠️ NO se deja en disco como las del visual. Aquellas son doce, pesadas, y se\n// arman despues en una plantilla, asi que viven en un volumen compartido; esta\n// es una sola y el servidor la lee y la olvida.\nconst binario = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst meta = $input.first().binary.data;\n\nreturn [{\n  json: {\n    storeId: 'clarvex-demo-store',\n    imagenBase64: binario.toString('base64'),\n    // Telegram recomprime las fotos a JPEG. Se manda lo que declare el binario\n    // y se cae a jpeg, que es lo que de verdad llega.\n    mimeType: meta && meta.mimeType ? meta.mimeType : 'image/jpeg'\n  }\n}];"
        },
        "id": "v0000000-0022-4000-8000-000000000022",
        "name": "Armar la promo",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "onError": "continueErrorOutput",
        "position": [
          -200,
          520
        ]
      },
      {
        "parameters": {
          "method": "POST",
          "url": "https://team.clarvex.tech/api/admin/capture/promos",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              {
                "name": "Authorization",
                "value": "=Bearer {{ $env.ADMIN_CAPTURE_SECRET }}"
              }
            ]
          },
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={{ JSON.stringify($json) }}",
          "options": {
            "timeout": 120000,
            "response": {
              "response": {
                "neverError": true,
                "fullResponse": true
              }
            }
          }
        },
        "id": "v0000000-0023-4000-8000-000000000023",
        "name": "Leer la promo",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "onError": "continueErrorOutput",
        "position": [
          40,
          520
        ]
      },
      {
        "parameters": {
          "jsCode": "// El endpoint contesta 201 con el comunicado ya redactado, o 4xx con el motivo\n// EN CLARO --y ese motivo es justo lo que hay que ensenar: dice QUE falta en la\n// captura, para poder mandar otra sin adivinar--.\n//\n// ⚠️ Por eso la peticion va con neverError: sin eso n8n lanzaria y el aviso\n// generico taparia el unico texto util de la respuesta.\nconst r = $json;\nconst cuerpo = r.body || {};\n\nif (r.statusCode !== 201) {\n  return [{ json: { respuesta: cuerpo.error || 'No se pudo leer la promocion.' } }];\n}\n\n// Telegram corta en 4096 caracteres. Se recorta el CUERPO y se avisa, en vez de\n// dejar que el mensaje se pierda entero o llegue mutilado sin decirlo.\nconst TOPE = 3200;\nlet texto = cuerpo.body || '';\nlet recortado = false;\nif (texto.length > TOPE) { texto = texto.slice(0, TOPE); recortado = true; }\n\nconst lineas = [\n  'Borrador listo en Clarvex. NO se publico nada.',\n  '',\n  cuerpo.title || '(sin titulo)',\n  '',\n  texto\n];\nif (recortado) lineas.push('', '[...] El comunicado sigue; abrelo en Clarvex para verlo completo.');\nlineas.push(\n  '',\n  'Revisalo antes de publicarlo. Los descuentos y las restricciones van tal cual los mando el corporativo.',\n  'El CODIGO es lo unico que nadie puede comprobar solo: compara digito por digito contra el correo.'\n);\n\nreturn [{ json: { respuesta: lineas.join('\\n') } }];"
        },
        "id": "v0000000-0024-4000-8000-000000000024",
        "name": "Decir el borrador",
