      {
        "parameters": {
          "jsCode": "// «visual cambiar 3 = MSW ZONA 1». El igual es opcional.\nconst t = ($json.message.text || '').trim();\nconst m = t.match(/^visual\\s+cambiar\\s+(\\d+)\\s*=?\\s*(.+)$/i);\nif (!m) {\n  // ⚠️ Se para aqui en vez de mandar una peticion a medias: con el numero\n  // o la zona vacios el servidor cambiaria lo que no es.\n  throw new Error('Escribelo asi: visual cambiar 3 = MSW ZONA 1');\n}\nreturn [{ json: { foto: Number(m[1]), etiqueta: m[2].trim() } }];"
        },
        "id": "v0000000-0032-4000-8000-000000000032",
        "name": "Leer el cambio",
        "type": "n8n-nodes-base.code",
