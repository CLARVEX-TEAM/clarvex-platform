        "id": "v0000000-0008-4000-8000-000000000008",
        "name": "Estado",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "onError": "continueErrorOutput",
        "position": [-440, 200]
      },
      {
        "parameters": {
          "jsCode": "const d = $json;\nconst huecos = d.huecos || [];\nconst listas = d.fotosListas || [];\nconst faltan = d.faltan || [];\n\nconst lineas = ['Reporte fotografico — ' + huecos.length + ' fotos', ''];\nfor (const h of huecos) {\n  const puesta = listas.some((l) => l.toLowerCase() === h.etiqueta.toLowerCase());\n  lineas.push((puesta ? '  [si] ' : '  [  ] ') + h.etiqueta);\n}\nlineas.push('');\nif (faltan.length === 0) {\n  lineas.push('Estan todas. Manda \"visual armar\".');\n} else {\n  lineas.push('Manda cada foto con su pie, por ejemplo:');\n  lineas.push('  visual ' + faltan[0].toLowerCase());\n}\nreturn [{ json: { respuesta: lineas.join('\\n') } }];"
        },
        "id": "v0000000-0009-4000-8000-000000000009",
        "name": "Formatear estado",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
