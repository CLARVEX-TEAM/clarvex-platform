      {
        "parameters": {
          "jsCode": "// La foto de la hoja viaja en base64, como la del reporte del POS.\n//\n// Se manda tambien el APTO de la tienda: es contra lo que el servidor comprueba\n// que la hoja sea SUYA --en una salida, la tienda es la ubicacion de envio--.\n// ⚠️ Va aqui y no sale de la base porque `Store` todavia no guarda el APTO. El\n// dia que lo guarde, esta linea sobra.\nconst binario = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst meta = $input.first().binary.data;\n\nreturn [{\n  json: {\n    storeId: 'clarvex-demo-store',\n    apto: '03029',\n    createdBy: 'telegram',\n    imagenBase64: binario.toString('base64'),\n    mimeType: meta && meta.mimeType ? meta.mimeType : 'image/jpeg'\n  }\n}];"
        },
