      {
        "parameters": {
          "jsCode": "// Se confirma con lo que el SERVIDOR ve en la carpeta, no con lo que\n// acabamos de escribir. Si el archivo no llego, aqui se nota.\nconst d = $json;\nconst faltan = d.faltan || [];\nconst v = $('Validar el pie').first().json;\nconst sinNombre = d.sinNombre || 0;\n\nconst lineas = [v.sinNombre ? 'Guardada, sin zona todavia.' : 'Guardada: ' + v.etiqueta, ''];\nif (sinNombre > 0) {\n  lineas.push('Van ' + sinNombre + ' sin zona. Cuando las tengas todas: \"visual reconocer\".');\n  if (faltan.length > sinNombre) {\n    lineas.push('');\n    lineas.push('Zonas sin foto: ' + faltan.length);\n  }\n} else if (faltan.length === 0) {\n  lineas.push('Ya estan las ' + (d.huecos || []).length + '. Manda \"visual armar\".');\n} else {\n  lineas.push('Faltan ' + faltan.length + ':');\n  for (const f of faltan) lineas.push('  ' + f);\n}\nreturn [{ json: { respuesta: lineas.join('\\n') } }];"
        },
        "id": "v0000000-0007-4000-8000-000000000007",
