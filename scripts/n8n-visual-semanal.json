        "id": "v0000000-0020-4000-8000-000000000020",
        "name": "Consultar huecos",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "onError": "continueErrorOutput",
        "position": [
          -460,
