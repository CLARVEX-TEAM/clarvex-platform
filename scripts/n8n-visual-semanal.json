        "name": "Bajar la foto",
        "type": "n8n-nodes-base.telegram",
        "typeVersion": 1.2,
        "onError": "continueErrorOutput",
        "position": [-440, -180],
        "credentials": {
          "telegramApi": { "id": "c7bIjyLeljGWy3yc", "name": "Telegram account 2" }
