      {
        "parameters": {
          "jsCode": "const d = $json;\nconst huecos = d.huecos || [];\nconst listas = d.fotosListas || [];\nconst faltan = d.faltan || [];\nconst sinNombre = d.sinNombre || 0;\n\nconst lineas = ['Reporte fotografico — ' + huecos.length + ' fotos', ''];\nfor (const h of huecos) {\n  const puesta = listas.some((l) => l.toLowerCase() === h.etiqueta.toLowerCase());\n  lineas.push((puesta ? '  [si] ' : '  [  ] ') + h.etiqueta);\n}\nlineas.push('');\nif (sinNombre > 0) {\n  lineas.push('Y ' + sinNombre + ' foto(s) esperando zona.');\n  lineas.push('Manda \"visual reconocer\" para repartirlas.');\n} else if (faltan.length === 0) {\n  lineas.push('Estan todas. Manda \"visual armar\".');\n} else {\n  lineas.push('Mandalas sin pie y luego \"visual reconocer\",');\n  lineas.push('o cada una con su nombre, por ejemplo:');\n  lineas.push('  ' + faltan[0].toLowerCase());\n}\nreturn [{ json: { respuesta: lineas.join('\\n') } }];"
