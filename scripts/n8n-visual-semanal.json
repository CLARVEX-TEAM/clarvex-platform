      {
        "parameters": {
          "jsCode": "// El pie \"visual WSW ZONA 1\" da el nombre del archivo, y ese nombre ES lo\n// que despues casa con la etiqueta de su diapositiva.\nconst pie = ($('Mensaje').first().json.message.caption || '').trim();\nconst etiqueta = pie.replace(/^visual\\s*/i, '').trim();\n\nif (!etiqueta) {\n  throw new Error('Dime que es: \"visual fachada\", \"visual wsw zona 1\"...');\n}\n\n// ⚠️ Lista blanca en el nombre del archivo. Esta carpeta la lee un proceso del\n// servidor, y una barra o dos puntos en el pie podrian sacar la escritura de\n// su sitio.\nconst PERMITIDOS = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789 ';\nlet limpio = '';\nfor (const c of etiqueta) limpio += PERMITIDOS.indexOf(c) >= 0 ? c : ' ';\nlimpio = limpio.replace(/\\s+/g, ' ').trim();\nif (!limpio) { throw new Error('Ese nombre no tiene letras ni numeros.'); }\n\nconst item = $input.first();\nreturn [{\n  json: { etiqueta: limpio, archivo: limpio + '.jpg' },\n  binary: item.binary\n}];"
        },
        "id": "v0000000-0004-4000-8000-000000000004",
        "name": "Nombrar la foto",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "onError": "continueErrorOutput",
        "position": [-240, -180]
      },
      {
        "parameters": {
          "operation": "write",
          "fileName": "=/visual/pendientes/{{ $json.archivo }}",
          "dataPropertyName": "data",
          "options": {}
        },
        "id": "v0000000-0005-4000-8000-000000000005",
        "name": "Guardar la foto",
        "type": "n8n-nodes-base.readWriteFile",
        "typeVersion": 1.1,
