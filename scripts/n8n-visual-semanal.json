        "id": "v0000000-0006-4000-8000-000000000006",
        "name": "Como va",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "onError": "continueErrorOutput",
        "position": [180, -180]
      },
      {
        "parameters": {
          "jsCode": "// Se confirma con lo que el SERVIDOR ve en la carpeta, no con lo que\n// acabamos de escribir. Si el archivo no llego, aqui se nota.\nconst d = $json;\nconst faltan = d.faltan || [];\nconst etiqueta = $('Nombrar la foto').first().json.etiqueta;\n\nconst lineas = ['Guardada: ' + etiqueta, ''];\nif (faltan.length === 0) {\n  lineas.push('Ya estan las ' + (d.huecos || []).length + '. Manda \"visual armar\".');\n} else {\n  lineas.push('Faltan ' + faltan.length + ':');\n  for (const f of faltan) lineas.push('  ' + f);\n}\nreturn [{ json: { respuesta: lineas.join('\\n') } }];"
        },
        "id": "v0000000-0007-4000-8000-000000000007",
        "name": "Decir que falta",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "onError": "continueErrorOutput",
        "position": [380, -180]
