.next/
node_modules/
# Playwright: los resultados y el informe son artefactos de cada corrida.
test-results/
playwright-report/
blob-report/
.playwright/
# Solo se versionan las capturas de LINUX, que es donde corre el CI. Las de
# Windows o macOS nunca coincidirían con las suyas (fuentes y antialiasing
# distintos) y solo añaden ruido al repositorio. En local se generan con
# `pnpm test:visual:update` y se quedan fuera del control de versiones.
tests/visual/__screenshots__/**/win32/
tests/visual/__screenshots__/**/darwin/
.env
.env.local
.env*.local
.env.test
.env.test.local
# Respaldos de .env: mismo contenido sensible, y sin esta linea `git add .`
# los subiria al repositorio.
.env.bak*
.env.backup*
*.env.bak
dist/
build/
dev.log
dev.out.log
dev.err.log
npm-debug.log*
*.log
*.tsbuildinfo
.DS_Store

# Claude Code / agent tooling — no pertenecen al repo del proyecto
.claude/
.agents/
public/uploads/profiles/*
!public/uploads/profiles/.gitkeep
public/uploads/evidences/*
!public/uploads/evidences/.gitkeep

# IDE / editor artifacts
.vs/
.vscode/settings.json
.idea/

# Certificates and private keys
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
.vercel

# Restos de Codex: configuracion local y fotos enviadas en sus sesiones.
# Ya no se usa, pero mientras las carpetas existan un `git add .` las subiria
# al historial, y de ahi no salen.
.codex/
.codex-remote-attachments/
