.next/
node_modules/
# Playwright: los resultados y el informe son artefactos de cada corrida.
test-results/
playwright-report/
blob-report/
.playwright/
# Solo se versionan las capturas de LINUX, que es donde corre el CI. Las de
# Windows o macOS nunca coincidirían con las suyas (fuentes y antialiasing
# distintos) y solo añaden ruido al repositorio. En local se generan con
# `pnpm test:visual:update` y se quedan fuera del control de versiones.
tests/visual/__screenshots__/**/win32/
tests/visual/__screenshots__/**/darwin/
.env
.env.local
.env*.local
.env.test
.env.test.local
# Respaldos de .env: mismo contenido sensible, y sin esta linea `git add .`
# los subiria al repositorio.
.env.bak*
.env.backup*
*.env.bak
# Dumps y respaldos de base de datos: pueden contener datos reales.
*.dump
*.pgdump
*.backup
/backups/
dist/
build/
dev.log
dev.out.log
dev.err.log
npm-debug.log*
*.log
*.tsbuildinfo
.DS_Store

